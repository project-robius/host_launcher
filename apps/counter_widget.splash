// The Counter home-screen widget: bump the count in place, without opening the
// app. A quick tap on a button fires its in-VM on_click; long-press still opens
// the tile's context menu, and (in edit mode) the tile is a drag handle.
//
// on_widget_resize hides the "COUNT" caption on a single-row tile and swaps the
// number between a small and large face by the width on hand (both faces are
// kept in sync by show(), the clock-widget pattern).
//
// The count is shared with the fullscreen app: persisted to /count.json on
// every change, and broadcast over same-app IPC so a live app isolate updates
// instantly (and vice versa). Both hops carry the count SIGN-SPLIT as
// [is_negative, magnitude] (the app writes the same shape): parse_json has no
// case for a leading "-", so a plain negative number silently loses its whole
// field on the way back in, and the − button walks below zero all the time.
let count = 0

fn show(){
    let s = "" + count
    ui.value_sm.set_text(s)
    ui.value_lg.set_text(s)
}

// The wire/disk shape, in numbers that always survive a JSON round trip.
fn payload(){
    if count < 0 { return [1, 0 - count] }
    return [0, count]
}

// Reads that shape back into count; false (and no change at all) if the
// value isn't intact, so a bad read can never half-update the counter.
fn take_payload(v){
    if !v.is_array() { return false }
    if !(v.len() == 2) { return false }
    if !v[0].is_number() { return false }
    if !v[1].is_number() { return false }
    let n = v[1]
    if v[0] == 1 { n = 0 - n }
    count = n
    return true
}

fn load(){
    if !fs.exists("/count.json") { return }
    let v = fs.read("/count.json").parse_json()
    if take_payload(v) { return }
    // A file from before the sign split: positive counts still load (a
    // negative one never made it back out), and the next tap rewrites it.
    if !v.is_object() { return }
    if !v.count.is_number() { return }
    count = v.count
}

// Called after every local change: persist FIRST, then nudge the app's
// isolate — a failed or undelivered send leaves the saved count untouched.
// Same-app IPC needs no permission (docs/PERMISSIONS.md), and tiles never
// prompt, so this stays fire-and-forget with a nil callback.
// on_ipc_message deliberately does NOT call this — no echo loops.
fn sync(){
    fs.write("/count.json", payload().to_json())
    host.request("ipc.send", {to: "self", data: payload()}, nil)
}

// The app changed the count; data arrives as a JSON string like [0, 3].
fn on_ipc_message(from, data){
    let took = take_payload(data.parse_json())
    if took { show() }
    return nil
}

fn on_widget_resize(cols, rows, w, h){
    ui.r_label.set_visible(rows >= 2)
    ui.value_sm.set_visible(w < 150)
    ui.value_lg.set_visible(w >= 150)
}

let _init = load()
let _boot = start_timeout(0.05, || show())

View{
    width: Fill
    height: Fit
    flow: Down
    spacing: 6
    align: Align{x: 0.5, y: 0.5}
    padding: Inset{left: 10, right: 10, top: 4, bottom: 8}

    r_label := Label{
        text: "COUNT"
        draw_text +: {
            color: #xd9e8ffcc
            text_style: theme.font_bold{font_size: 10}
        }
    }
    value_lg := Label{
        text: "0"
        draw_text +: {
            color: #ffffff
            text_style: theme.font_bold{font_size: 40}
        }
    }
    value_sm := Label{
        visible: false
        text: "0"
        draw_text +: {
            color: #ffffff
            text_style: theme.font_bold{font_size: 26}
        }
    }
    View{
        width: Fit
        height: Fit
        flow: Right
        spacing: 8
        align: Align{x: 0.5}
        glass.GlassButton{text: "−" width: 46 height: 38 on_click: || { count -= 1  show()  sync() }}
        glass.GlassButtonProminent{text: "+" width: 46 height: 38 on_click: || { count += 1  show()  sync() }}
    }
}
