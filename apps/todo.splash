// A to-do list: add tasks, tap to toggle done, clear the finished ones.
// Uses the pre-allocated fixed-slot pattern (dynamic `for`-render of widgets with
// per-row handlers doesn't reliably re-render on array changes).
// Tasks persist in the app's private storage (the sandboxed `fs`) as JSON.
//
// Permissions: declares `ipc` only to RECEIVE (on_ipc_message). It never calls
// a host service, so every feature works with zero grants and a denied `ipc`
// costs nothing but incoming tasks — the host stops delivering, no UI changes.
//
// Responsive: the column is capped+centered on wide hosts (Fill{max}); narrow
// hosts drop the Add button (on_return still adds) and shorten the fixed
// button/hint texts via set_text; short hosts drop our H1 and the hint (the
// host header already names the app), keeping the input + list in view.
let items = [
    {text: "Try the Weather app" done: false}
    {text: "Rearrange some icons" done: true}
    {text: "Add a widget to the home screen" done: false}
]
let max_items = 8
// True once the boot timeout has run, i.e. once `ui` is safe to touch.
let booted = false

fn save(){
    fs.write("/todo.json", items.to_json())
}

fn load(){
    if fs.exists("/todo.json") {
        let parsed = fs.read("/todo.json").parse_json()
        if parsed.is_array() {
            items = parsed
        }
    }
}

fn slot_text(i){
    let mark = "○  "
    if items[i].done { mark = "●  " }
    mark + items[i].text
}

fn sync_row(row, i){
    if i < items.len() {
        row.set_visible(true)
        row.label.set_text(slot_text(i))
    } else {
        row.set_visible(false)
    }
}

fn refresh(){
    let remaining = 0
    for item in items {
        if !item.done { remaining += 1 }
    }
    ui.status.set_text("" + remaining + " remaining · " + items.len() + " total")
    sync_row(ui.row_0, 0)
    sync_row(ui.row_1, 1)
    sync_row(ui.row_2, 2)
    sync_row(ui.row_3, 3)
    sync_row(ui.row_4, 4)
    sync_row(ui.row_5, 5)
    sync_row(ui.row_6, 6)
    sync_row(ui.row_7, 7)
}

fn add_task(text){
    let clean = ("" + text).trim()
    if clean == "" { return }
    if items.len() >= max_items { return }
    items.push({text: clean done: false})
    save()
    ui.task_input.set_text("")
    refresh()
}

// Other apps (e.g. notes) can send us {task: "..."} over IPC; `data` is a JSON
// string from a sender we don't control, so every step is guarded and a bad
// message is dropped whole rather than half-applied. Same trim/empty/cap
// checks as add_task, minus the input-clearing (nothing was typed here), plus
// a length cap so one sender can't blow the row or the storage quota.
//
// We deliberately do NOT gate this on host.has("ipc"): receiving costs us no
// capability. The host only delivers while the user leaves our declared `ipc`
// grant on (it refuses the sender otherwise), and same-app messages are free
// regardless — checking here would drop legitimate ones.
fn on_ipc_message(from, data){
    if !data.is_string() { return nil }
    let parsed = data.parse_json()
    if !parsed.is_object() { return nil }
    let task = parsed.task
    if !task.is_string() { return nil }
    let clean = task.trim()
    if clean == "" { return nil }
    if clean.len() > 400 { return nil }
    if items.len() >= max_items { return nil }
    items.push({text: clean done: false})
    save()
    // A message can land before the boot timeout hands us `ui`; the task is
    // saved either way and the boot refresh() draws it.
    if !booted { return nil }
    refresh()
}

fn toggle_task(i){
    if i >= items.len() { return }
    items[i] += {done: !items[i].done}
    save()
    refresh()
}

fn on_app_resize(w, h){
    // Narrow: the 70px Add button would squeeze the input to a sliver, so
    // hide it (the input's on_return still adds) and shorten fixed texts.
    let narrow = w < 240
    ui.add_wrap.set_visible(!narrow)
    if narrow {
        ui.hint.set_text("TAP TO TOGGLE")
        ui.clear_btn.set_text("Clear done")
    } else {
        ui.hint.set_text("TAP A TASK TO TOGGLE IT")
        ui.clear_btn.set_text("Clear completed")
    }
    // Short: drop our own title and the hint (the host header already names
    // the app) so the input and a few tasks fit; the host scrolls the rest.
    ui.title_row.set_visible(h >= 480)
    ui.hint_row.set_visible(h >= 480)
}

let TaskRow = glass.ListRow{
    width: Fill
    visible: false
    label := ButtonFlatter{
        width: Fill
        height: Fill
        align: Align{x: 0.0, y: 0.5}
        text: ""
        draw_text +: { color: #xf2f6ff }
    }
}

// Load at eval time (top level), BEFORE any handler can fire and save() over
// the file; only the initial refresh() — which needs the `ui` handles that
// exist just after eval — is deferred.
let _init = load()
let _boot = start_timeout(0.05, || {
    booted = true
    refresh()
})

View{
    width: Fill
    height: Fit
    flow: Down
    align: Align{x: 0.5}

    col := View{
        width: Fill{max: 560.0}
        height: Fit
        flow: Down
        spacing: 12
        padding: 14

        title_row := View{
            width: Fill
            height: Fit
            glass.H1{text: "To-Do"}
        }
        status := glass.Caption{text: ""}

        glass.Group{
            width: Fill
            height: Fit
            flow: Right
            spacing: 8
            task_input := glass.TextInput{
                width: Fill
                height: 38
                empty_text: "Add a task..."
                on_return: |text| add_task(text)
            }
            add_wrap := View{
                width: Fit
                height: Fit
                glass.GlassButtonProminent{text: "Add" width: 70 height: 38 on_click: || add_task(ui.task_input.text())}
            }
        }

        hint_row := View{
            width: Fill
            height: Fit
            hint := glass.Caption{text: "TAP A TASK TO TOGGLE IT"}
        }
        list := View{
            width: Fill
            height: Fit
            flow: Down
            spacing: 8
            row_0 := TaskRow{label.on_click: || toggle_task(0)}
            row_1 := TaskRow{label.on_click: || toggle_task(1)}
            row_2 := TaskRow{label.on_click: || toggle_task(2)}
            row_3 := TaskRow{label.on_click: || toggle_task(3)}
            row_4 := TaskRow{label.on_click: || toggle_task(4)}
            row_5 := TaskRow{label.on_click: || toggle_task(5)}
            row_6 := TaskRow{label.on_click: || toggle_task(6)}
            row_7 := TaskRow{label.on_click: || toggle_task(7)}
        }

        clear_btn := glass.GlassButton{text: "Clear completed" width: Fill height: 40 on_click: || {
            items.retain(|item| !item.done)
            save()
            refresh()
        }}
    }
}
