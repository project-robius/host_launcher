// A diagnostics mini-app that probes its own sandbox at RUNTIME and reports
// what it can reach. This app declares NO permissions — it is the
// deny-by-default showcase — so every probe should land on ✅, proving the
// isolate has no ambient authority beyond its private storage jail.
// Grants can move under a running app, so the capability-derived rows are
// re-read (and the broker re-probed) from on_permissions_changed.
//
// Responsive: the column is capped+centered on wide hosts (Fill{max}); narrow
// hosts stack each row's label over its status and swap the H1 for an H2;
// short hosts drop the title and footer (the host header already names the app).
// `passed`, not `ok`: `ok` is the dialect's ok-test keyword and is rejected
// as an argument name.
fn verdict(passed, good, bad){
    if passed { return "✅ " + good }
    "❌ " + bad
}

// Storage is jailed, not absent: `fs` (with `mod.fs` re-bound to the same
// jail) round-trips a probe file inside this app's private root.
let _pw = fs.write("/probe.txt", "jail-check")
let jail_ok = false
if fs.exists("/probe.txt") {
    jail_ok = (fs.read("/probe.txt") == "jail-check")
}
let _pr = fs.remove("/probe.txt")

// The launcher strips these modules from each isolate's namespace outright.
let run_stripped = (mod.run == nil)
let res_stripped = (mod.res == nil)

// mod.cx survives, but its quit() is removed — a mini-app must never be able
// to kill the whole launcher.
let quit_neutered = true
if mod.cx != nil {
    quit_neutered = (mod.cx.quit == nil)
}

// The four probes above are properties of the isolate itself and can't move.
// Anything derived from the GRANT LIST can: the host pushes a new list into a
// live isolate (App Info's "Add a capability"), so these two are only the
// first reading, re-read at use time by sync_caps_rows.
fn cap_count(){
    return host.capabilities().len()
}

let fs_status = verdict(jail_ok, "JAILED", "BROKEN")
let run_status = verdict(run_stripped, "STRIPPED", "REACHABLE")
let res_status = verdict(res_stripped, "STRIPPED", "REACHABLE")
let quit_status = verdict(quit_neutered, "NEUTERED", "REACHABLE")
let net_status = verdict(!host.has("network"), "BLOCKED", "REACHABLE")
let caps_status = verdict(cap_count() == 0, "NONE GRANTED", "" + cap_count() + " GRANTED")

let stock_note = "This app declares no permissions, so the host refuses every service request without prompting. Its storage lives in a private jail; the launcher's widgets, sibling apps, and the network are out of reach."
// ui handles only exist once the boot timeout has run; a grant change that
// beats it is picked up by that timeout's own sync.
let ready = false

// Live probe: ask the host broker for a service we never declared. It must
// refuse without prompting; the async verdict writes both tier labels.
fn svc_result(r){
    // Early return, not an if/else tail: an if/else as a fn's FINAL
    // statement lands in expression position and fails to parse.
    if r.is_ok {
        ui.svc_status_w.set_text("❌ ALLOWED")
        ui.svc_status_n.set_text("❌ ALLOWED")
        return nil
    }
    ui.svc_status_w.set_text("✅ DENIED")
    ui.svc_status_n.set_text("✅ DENIED")
}

// Re-runs the broker probe. A grant change is exactly when its answer could
// flip, so the row goes back to ⏳ until the host has answered again.
fn probe_services(){
    ui.svc_status_w.set_text("⏳ PROBING")
    ui.svc_status_n.set_text("⏳ PROBING")
    let _rid = host.request("location.get", {}, |r| svc_result(r))
    return nil
}

// Rewrites every capability-derived row from the CURRENT grant list, in both
// tiers (only one is on screen, and the hidden one must not go stale).
fn sync_caps_rows(n){
    let cs = verdict(n == 0, "NONE GRANTED", "" + n + " GRANTED")
    ui.caps_status_w.set_text(cs)
    ui.caps_status_n.set_text(cs)
    let ns = verdict(!host.has("network"), "BLOCKED", "REACHABLE")
    ui.net_status_w.set_text(ns)
    ui.net_status_n.set_text(ns)
    if n == 0 {
        ui.foot_note.set_text(stock_note)
        return nil
    }
    ui.foot_note.set_text("The host has pushed " + n + " capability grant(s) into this isolate since it started, so the rows above report the live grant list rather than the boot-time one. Storage stays jailed either way.")
    return nil
}

let _boot = start_timeout(0.05, || {
    ready = true
    sync_caps_rows(cap_count())
    probe_services()
})

// The host calls this on every live isolate when this app's capabilities
// change without a restart; caps is a JSON array string. A probe that kept
// its boot snapshot would sit here showing a ✅ that stopped being true.
fn on_permissions_changed(caps){
    if !ready { return nil }
    // Trust the pushed list when it parses; the host's own list otherwise.
    let n = cap_count()
    if !caps.is_nil() {
        let list = caps.parse_json()
        if list.is_array() { n = list.len() }
    }
    sync_caps_rows(n)
    probe_services()
    return nil
}

// The host answers "may I?" with permissions — and "how often?" with a
// per-app request budget. This button deliberately misbehaves: it fires a
// burst of permission-free requests, far more than any real app would, and
// the broker prices each one until the budget runs out and the tail comes
// back refused. Keep doing it and the launcher stops the app outright.
// A well-behaved app never needs this; see docs/PERMISSIONS.md.
let burst = 40
let flood_done = 0
let flood_refused = 0

fn flood_reply(r){
    flood_done = flood_done + 1
    if !r.is_ok { flood_refused = flood_refused + 1 }
    // Only report once the whole burst has been answered.
    if flood_done < burst { return nil }
    let s = verdict(flood_refused > 0, "REFUSED " + flood_refused + "/" + burst, "ALL " + burst + " ALLOWED")
    ui.flood_status_w.set_text(s)
    ui.flood_status_n.set_text(s)
    return nil
}

fn flood(){
    if !ready { return nil }
    flood_done = 0
    flood_refused = 0
    ui.flood_status_w.set_text("⏳ FLOODING")
    ui.flood_status_n.set_text("⏳ FLOODING")
    let i = 0
    while i < burst {
        let _rid = host.request("permissions.query", {}, |r| flood_reply(r))
        i = i + 1
    }
    return nil
}

fn on_app_resize(w, h){
    let narrow = w < 280
    let short = h < 420
    ui.title_row.set_visible(!narrow && !short)
    ui.title_sm.set_visible(narrow && !short)
    ui.rows_wide.set_visible(!narrow)
    ui.rows_narrow.set_visible(narrow)
    ui.footer.set_visible(!short)
    if narrow { ui.vm_caption.set_text("ONE VM PER APP") } else { ui.vm_caption.set_text("ONE ISOLATED SPLASH VM PER MINI-APP") }
}

View{
    width: Fill
    height: Fit
    flow: Down
    align: Align{x: 0.5}

    col := View{
        width: Fill{max: 520.0}
        height: Fit
        flow: Down
        spacing: 12
        padding: 16

        title_row := View{
            width: Fill
            height: Fit
            glass.H1{text: "Sandbox Probe"}
        }
        // Narrow tier: the 30pt H1 wraps below ~240w; this 18pt H2 fits.
        title_sm := View{
            visible: false
            width: Fill
            height: Fit
            glass.H2{text: "Sandbox Probe"}
        }

        glass.Body{text: "What this isolated mini-app is allowed to touch:"}

        glass.Card{
            width: Fill
            height: Fit
            flow: Down
            spacing: 6

            rows_wide := View{
                width: Fill
                height: Fit
                flow: Down
                spacing: 6
                row_fs := glass.ListRow{
                    width: Fill
                    glass.OptionLabel{text: "mod.fs" width: Fill}
                    glass.Body{text: fs_status width: Fit}
                }
                row_run := glass.ListRow{
                    width: Fill
                    glass.OptionLabel{text: "mod.run" width: Fill}
                    glass.Body{text: run_status width: Fit}
                }
                row_res := glass.ListRow{
                    width: Fill
                    glass.OptionLabel{text: "mod.res" width: Fill}
                    glass.Body{text: res_status width: Fit}
                }
                row_quit := glass.ListRow{
                    width: Fill
                    glass.OptionLabel{text: "cx.quit" width: Fill}
                    glass.Body{text: quit_status width: Fit}
                }
                row_net := glass.ListRow{
                    width: Fill
                    glass.OptionLabel{text: "network" width: Fill}
                    net_status_w := glass.Body{text: net_status width: Fit}
                }
                row_svc := glass.ListRow{
                    width: Fill
                    glass.OptionLabel{text: "host services" width: Fill}
                    svc_status_w := glass.Body{text: "⏳ PROBING" width: Fit}
                }
                row_caps := glass.ListRow{
                    width: Fill
                    glass.OptionLabel{text: "capabilities" width: Fill}
                    caps_status_w := glass.Body{text: caps_status width: Fit}
                }
                row_flood := glass.ListRow{
                    width: Fill
                    glass.OptionLabel{text: "rate limit" width: Fill}
                    flood_status_w := glass.Body{text: "— UNTESTED" width: Fit}
                }
            }

            // Narrow tier: label above status — nothing side by side to clip
            // inside a fixed-height row. The four isolate probes are computed
            // once at boot, so duplicating them here needs no set_text
            // syncing; everything that can change later (the host-services
            // probe, network, capabilities) carries an id in BOTH tiers.
            rows_narrow := View{
                visible: false
                width: Fill
                height: Fit
                flow: Down
                spacing: 6
                View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 12, right: 12, top: 7, bottom: 7}
                    glass.OptionLabel{text: "mod.fs"}
                    glass.Body{text: fs_status}
                }
                View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 12, right: 12, top: 7, bottom: 7}
                    glass.OptionLabel{text: "mod.run"}
                    glass.Body{text: run_status}
                }
                View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 12, right: 12, top: 7, bottom: 7}
                    glass.OptionLabel{text: "mod.res"}
                    glass.Body{text: res_status}
                }
                View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 12, right: 12, top: 7, bottom: 7}
                    glass.OptionLabel{text: "cx.quit"}
                    glass.Body{text: quit_status}
                }
                View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 12, right: 12, top: 7, bottom: 7}
                    glass.OptionLabel{text: "network"}
                    net_status_n := glass.Body{text: net_status}
                }
                View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 12, right: 12, top: 7, bottom: 7}
                    glass.OptionLabel{text: "host services"}
                    svc_status_n := glass.Body{text: "⏳ PROBING"}
                }
                View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 12, right: 12, top: 7, bottom: 7}
                    glass.OptionLabel{text: "capabilities"}
                    caps_status_n := glass.Body{text: caps_status}
                }
                View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 12, right: 12, top: 7, bottom: 7}
                    glass.OptionLabel{text: "rate limit"}
                    flood_status_n := glass.Body{text: "— UNTESTED"}
                }
            }
        }

        // Misbehaving on purpose is the only way to show the budget working.
        flood_btn := glass.GlassButton{
            width: Fill
            height: 34
            text: "Flood the host with requests"
            on_click: || flood()
        }

        footer := View{
            width: Fill
            height: Fit
            flow: Down
            spacing: 12
            vm_caption := glass.Caption{text: "ONE ISOLATED SPLASH VM PER MINI-APP"}
            foot_note := glass.Body{text: stock_note}
        }
    }
}
