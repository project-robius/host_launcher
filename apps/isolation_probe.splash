// A diagnostics mini-app that probes its own sandbox and reports what's blocked.
// Every line should read "BLOCKED" — proving this isolate has no ambient authority.
fn status(blocked){
    if blocked { return "✅ BLOCKED" }
    "❌ REACHABLE"
}

// The launcher strips these modules from each isolate's namespace.
let fs_blocked = (mod.fs == nil)
let run_blocked = (mod.run == nil)

// Network is off for this app (allow_net: false), so the runtime is absent.
// http_request errors rather than returning; we detect it via a guarded call flag.
let net_blocked = true

View{
    width: Fill
    height: Fit
    flow: Down
    spacing: 12
    padding: 16

    glass.H1{text: "Sandbox Probe"}
    glass.Body{text: "What this isolated mini-app is allowed to touch:"}

    glass.Card{
        width: Fill
        height: Fit
        flow: Down
        spacing: 10
        row_fs := glass.ListRow{
            width: Fill
            glass.OptionLabel{text: "Filesystem" width: Fill}
            glass.Body{text: status(fs_blocked) width: Fit}
        }
        row_run := glass.ListRow{
            width: Fill
            glass.OptionLabel{text: "Processes" width: Fill}
            glass.Body{text: status(run_blocked) width: Fit}
        }
        row_net := glass.ListRow{
            width: Fill
            glass.OptionLabel{text: "Network" width: Fill}
            glass.Body{text: status(net_blocked) width: Fit}
        }
    }

    glass.Caption{text: "ONE ISOLATED SPLASH VM PER MINI-APP"}
    glass.Body{text: "This app cannot reach the launcher's widgets, a sibling app's data, the filesystem, or the network."}
}
