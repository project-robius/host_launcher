// A stopwatch with lap times. A deletable "user-installed" sample app.
//
// permissions: share, clipboard-write
// why-share: Sends your lap times wherever you want them.
// why-clipboard-write: Copies your lap times so you can paste them anywhere.
//
// Both are for one thing — getting the laps OUT — and both are optional: the
// list on screen is the real record, so with everything denied the app is
// exactly what it was.
//
// Responsive: the column is capped+centered on wide hosts (Fill{max}), the
// Start/Lap/Reset buttons are width:Fill so they compress on narrow hosts,
// and on_app_resize swaps pre-declared tiers (fonts and ScrollYView heights
// can't change at runtime): a compact display for narrow/short panes, and
// three lap-list heights picked by host height.
let running = false
let elapsed = 0.0
let last = 0.0
let laps = []
// Grant states as the host last reported them; never cached from boot alone.
let share_state = "ask"
let copy_state = "ask"
let ready = false

fn fmt(t){
    let mins = floor(t / 60.0)
    let secs = floor(t % 60.0)
    let tenths = floor((t * 10.0) % 10.0)
    let m = "" + mins
    if mins < 10 { m = "0" + mins }
    let s = "" + secs
    if secs < 10 { s = "0" + secs }
    m + ":" + s + "." + tenths
}

fn show_time(s){
    ui.display.set_text(s)
    ui.display_sm.set_text(s)
}

fn render_laps(){
    ui.lap_list.render()
    ui.lap_list_sm.render()
    ui.lap_list_tall.render()
}

fn on_app_resize(w, h){
    // Compact: the 48px time needs ~250px of width, and a short pane needs
    // the controls above the fold (the host header already names the app).
    let compact = (w < 260) || (h < 420)
    ui.title_row.set_visible(!compact)
    ui.disp_lg.set_visible(!compact)
    ui.disp_sm.set_visible(compact)
    // Lap list: ScrollYView heights are fixed, so pick one of three tiers.
    ui.laps_sm.set_visible(h < 550)
    ui.laps_md.set_visible((h >= 550) && (h < 800))
    ui.laps_tall.set_visible(h >= 800)
    // The visible tier may never have rendered ("No laps yet." included).
    render_laps()
}

// The laps as text, built locally — which is why a denial costs nothing: the
// same content is on screen either way.
fn laps_text(){
    if laps.len() == 0 { return "No laps yet." }
    let out = "Stopwatch - " + laps.len() + " laps"
    let i = 0
    while i < laps.len() {
        out = out + "\n" + "Lap " + (i + 1) + "  " + laps[i]
        i += 1
    }
    return out
}

fn say(msg){
    if !ready { return nil }
    ui.out_status.set_text(msg)
    return nil
}

// Which of the two buttons are worth offering. A button whose only possible
// outcome is a refusal is worse than no button, so a DENIED capability retires
// its own; an unanswered one stays, because that tap is what raises the prompt.
fn sync_out(){
    if !ready { return nil }
    let can_share = host.has("share") || (share_state != "denied")
    let can_copy = host.has("clipboard-write") || (copy_state != "denied")
    ui.share_wrap.set_visible(can_share)
    ui.copy_wrap.set_visible(can_copy)
    ui.out_row.set_visible(can_share || can_copy)
    ui.out_none.set_visible(!can_share && !can_copy)
    return nil
}

// `permissions.query` needs no permission of its own, which is what lets this
// tell "not answered yet" apart from "refused" without guessing.
fn query_out(){
    let _q = host.request("permissions.query", {}, fn(r){
        if !r.is_ok { return nil }
        let d = r.data
        if !d.is_object() { return nil }
        let sh = d.share
        if !sh.is_nil() { share_state = "" + sh }
        let cw = d.clipboard-write
        if !cw.is_nil() { copy_state = "" + cw }
        sync_out()
        return nil
    })
    return nil
}

fn share_laps(){
    if laps.len() == 0 {
        say("Take a lap first.")
        return nil
    }
    let _s = host.request("share", {text: laps_text()}, fn(r){
        if r.is_ok {
            say("Share sheet opened.")
            return nil
        }
        say("Sharing is off - your laps are listed above.")
        query_out()
        return nil
    })
    return nil
}

fn copy_laps(){
    if laps.len() == 0 {
        say("Take a lap first.")
        return nil
    }
    let _c = host.request("clipboard.write", {text: laps_text()}, fn(r){
        if r.is_ok {
            say("Copied.")
            return nil
        }
        say("Clipboard is off - your laps are listed above.")
        query_out()
        return nil
    })
    return nil
}

// The host calls this when a grant changes without restarting us, so the two
// buttons follow the switches in App Info immediately.
fn on_permissions_changed(caps){
    if !ready { return nil }
    if host.has("share") { share_state = "granted" }
    if host.has("clipboard-write") { copy_state = "granted" }
    sync_out()
    query_out()
    return nil
}

let _boot = start_timeout(0.05, || {
    ready = true
    render_laps()
    sync_out()
    query_out()
})

let _tick = start_interval(0.1, || {
    if running {
        let now = time_now()
        elapsed += now - last
        last = now
        show_time(fmt(elapsed))
    }
})

let LapList = ScrollYView{
    width: Fill
    flow: Down
    spacing: 6
    on_render: || {
        // Single-path emission: a one-shot while stands in for the
        // empty-state if/else, rows are indexed whiles on plain RoundedView
        // roots (old emission bugs fixed upstream, SPLASH_FINDINGS #12).
        let n = laps.len()
        let ph = 0
        if n == 0 { ph = 1 }
        while ph > 0 {
            glass.Body{text: "No laps yet." width: Fill}
            ph -= 1
        }
        let i = 0
        while i < n {
            let lap = laps[i]
            RoundedView{
                width: Fill
                height: Fit
                flow: Right
                spacing: 8.0
                align: Align{y: 0.5}
                padding: 10.0
                new_batch: true
                show_bg: true
                draw_bg +: {
                    color: #xffffff0d
                    border_radius: 10.0
                }
                glass.Body{text: ("Lap " + (i + 1)) width: Fill}
                Label{
                    text: lap
                    padding: 0.0
                    margin: 0.0
                    draw_text +: {
                        color: #x9dccff
                        text_style: theme.font_regular{font_size: 14}
                    }
                }
            }
            i += 1
        }
    }
}

View{
    width: Fill
    height: Fit
    flow: Down
    align: Align{x: 0.5}

    col := View{
        width: Fill{max: 520.0}
        height: Fit
        flow: Down
        spacing: 14
        padding: 16
        align: Align{x: 0.5}

        title_row := View{
            width: Fill
            height: Fit
            align: Align{x: 0.5}
            glass.H1{text: "Stopwatch"}
        }

        disp_lg := View{
            width: Fill
            height: Fit
            glass.Card{
                width: Fill
                height: Fit
                align: Align{x: 0.5, y: 0.5}
                padding: 26
                display := Label{
                    text: "00:00.0"
                    draw_text +: {
                        color: #ffffff
                        text_style: theme.font_bold{font_size: 48}
                    }
                }
            }
        }

        // Compact display tier: smaller figure fits a ~190px-wide pane and
        // keeps the buttons above the fold in a ~250px-tall one.
        disp_sm := View{
            visible: false
            width: Fill
            height: Fit
            glass.Card{
                width: Fill
                height: Fit
                align: Align{x: 0.5, y: 0.5}
                padding: Inset{top: 12, bottom: 12, left: 14, right: 14}
                display_sm := Label{
                    text: "00:00.0"
                    draw_text +: {
                        color: #ffffff
                        text_style: theme.font_bold{font_size: 30}
                    }
                }
            }
        }

        View{width: Fill height: Fit flow: Right spacing: 10
            start_stop := glass.GlassButtonProminent{text: "Start" width: Fill height: 52 on_click: || {
                running = !running
                if running {
                    last = time_now()
                    ui.start_stop.set_text("Stop")
                } else {
                    ui.start_stop.set_text("Start")
                }
            }}
            glass.GlassButton{text: "Lap" width: Fill height: 52 on_click: || {
                if running {
                    laps.push(fmt(elapsed))
                    render_laps()
                }
            }}
            glass.GlassButton{text: "Reset" width: Fill height: 52 on_click: || {
                running = false
                elapsed = 0.0
                laps.clear()
                ui.start_stop.set_text("Start")
                show_time("00:00.0")
                render_laps()
                say("")
            }}
        }

        out_row := View{
            width: Fill
            height: Fit
            flow: Right
            spacing: 10
            share_wrap := View{ width: Fill height: Fit
                glass.GlassButton{text: "Share laps" width: Fill height: 44
                    on_click: || share_laps()
                }
            }
            copy_wrap := View{ width: Fill height: Fit
                glass.GlassButton{text: "Copy" width: Fill height: 44
                    on_click: || copy_laps()
                }
            }
        }

        out_none := View{
            visible: false
            width: Fill
            height: Fit
            glass.Body{text: "Sharing and clipboard are off - your laps are listed above." width: Fill}
        }

        out_status := Label{
            text: ""
            draw_text +: {
                color: #x9dccffcc
                text_style: theme.font_regular{font_size: 10.5}
            }
        }

        glass.Caption{text: "LAPS"}

        laps_sm := View{
            visible: false
            width: Fill
            height: Fit
            lap_list_sm := LapList{height: 120}
        }
        laps_md := View{
            width: Fill
            height: Fit
            lap_list := LapList{height: 220}
        }
        laps_tall := View{
            visible: false
            width: Fill
            height: Fit
            lap_list_tall := LapList{height: 520}
        }
    }
}
