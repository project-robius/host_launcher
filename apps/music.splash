// A mock music player with a working queue and play/pause state.
//
// Responsive: the column is capped+centered on wide hosts (Fill{max}); a
// Fill-width transport tier swaps in below 340w (fixed 64/80px buttons can't
// shrink at runtime); the disc art, H1, and slider hide on short hosts so the
// transport stays above the fold; the queue re-renders title-only rows when
// narrow (host_w is read at build time inside on_render).
let tracks = [
    {title: "Midnight Drive" artist: "Neon Palms" len: "3:42"}
    {title: "Glass Gardens" artist: "Aurora Field" len: "4:05"}
    {title: "Low Tide" artist: "Cobalt Bay" len: "2:58"}
    {title: "Satellites" artist: "Vega Street" len: "3:21"}
]
let current = 0
let playing = false
let host_w = 400.0

fn sync_player(){
    let t = tracks[current]
    ui.track_title.set_text(t.title)
    let artist = t.artist + " · " + t.len
    if host_w < 340 { artist = t.artist }
    ui.track_artist.set_text(artist)
    if playing {
        ui.play_button.set_text("⏸")
        ui.play_button_sm.set_text("⏸")
        ui.state_label.set_text("Now playing")
    } else {
        ui.play_button.set_text("▶")
        ui.play_button_sm.set_text("▶")
        ui.state_label.set_text("Paused")
    }
    sync_queue_row(0)
    sync_queue_row(1)
    sync_queue_row(2)
    sync_queue_row(3)
}

fn sync_queue_row(i){
    let t = tracks[i]
    let marker = "  "
    if i == current { marker = "▸ " }
    let line = marker + t.title + " — " + t.artist
    if host_w < 340 { line = marker + t.title }
    if i == 0 { ui.q0.line.set_text(line) ui.q0.len.set_text(t.len) }
    if i == 1 { ui.q1.line.set_text(line) ui.q1.len.set_text(t.len) }
    if i == 2 { ui.q2.line.set_text(line) ui.q2.len.set_text(t.len) }
    if i == 3 { ui.q3.line.set_text(line) ui.q3.len.set_text(t.len) }
}

fn play_index(i){
    current = i
    playing = true
    sync_player()
}

fn prev_track(){
    current = (current + tracks.len() - 1) % tracks.len()
    sync_player()
}

fn next_track(){
    current = (current + 1) % tracks.len()
    sync_player()
}

fn toggle_play(){
    playing = !playing
    sync_player()
}

fn on_app_resize(w, h){
    host_w = w
    let narrow = w < 340
    ui.transport_lg.set_visible(!narrow)
    ui.transport_sm.set_visible(narrow)
    // The host header already says "Music", so the H1 and disc art are the
    // first things to go when vertical space is tight.
    ui.title_row.set_visible(h >= 480)
    ui.disc_row.set_visible(h >= 480)
    ui.slider_row.set_visible(h >= 380)
    // Re-sync so the narrow title-only queue lines and artist text track the
    // new width.
    sync_player()
}

let QueueRow = RoundedView{
    width: Fill
    height: Fit
    flow: Right
    spacing: 8
    align: Align{y: 0.5}
    padding: 10
    new_batch: true
    show_bg: true
    draw_bg +: {
        color: #xffffff0d
        border_radius: 10.0
    }
    line := glass.Body{text: "" width: Fill}
    len := glass.Caption{text: ""}
}

let _boot = start_timeout(0.05, || sync_player())

View{
    width: Fill
    height: Fit
    flow: Down
    align: Align{x: 0.5}

    col := View{
        width: Fill{max: 520.0}
        height: Fit
        flow: Down
        spacing: 12
        padding: 14

        title_row := View{
            width: Fill
            height: Fit
            glass.H1{text: "Music"}
        }

        glass.Panel{
            width: Fill
            height: Fit
            flow: Down
            spacing: 10
            align: Align{x: 0.5}
            padding: 20

            disc_row := View{
                width: Fill
                height: Fit
                align: Align{x: 0.5}
                Label{
                    text: "💿"
                    draw_text +: {
                        color: #ffffff
                        text_style: theme.font_regular{font_size: 44}
                    }
                }
            }
            track_title := glass.H2{text: "—" width: Fill align: Align{x: 0.5}}
            track_artist := glass.Body{text: "" width: Fill align: Align{x: 0.5}}
            state_label := glass.Caption{text: "Paused"}

            slider_row := View{
                width: Fill
                height: Fit
                glass.GlassSlider{width: Fill}
            }

            transport_lg := View{
                width: Fill
                height: Fit
                flow: Right
                spacing: 12
                align: Align{x: 0.5}
                glass.GlassButton{text: "⏮" width: 64 height: 48 on_click: || prev_track()}
                play_button := glass.GlassButtonProminent{text: "▶" width: 80 height: 48 on_click: || toggle_play()}
                glass.GlassButton{text: "⏭" width: 64 height: 48 on_click: || next_track()}
            }

            // Narrow tier: Fill-width buttons split whatever width exists.
            transport_sm := View{
                visible: false
                width: Fill
                height: Fit
                flow: Right
                spacing: 6
                glass.GlassButton{text: "⏮" width: Fill height: 44 on_click: || prev_track()}
                play_button_sm := glass.GlassButtonProminent{text: "▶" width: Fill height: 44 on_click: || toggle_play()}
                glass.GlassButton{text: "⏭" width: Fill height: 44 on_click: || next_track()}
            }
        }

        glass.Caption{text: "UP NEXT · TAP A NUMBER TO PLAY"}
        View{
            width: Fill
            height: Fit
            flow: Right
            spacing: 8
            glass.GlassButton{text: "1" width: Fill height: 38 on_click: || play_index(0)}
            glass.GlassButton{text: "2" width: Fill height: 38 on_click: || play_index(1)}
            glass.GlassButton{text: "3" width: Fill height: 38 on_click: || play_index(2)}
            glass.GlassButton{text: "4" width: Fill height: 38 on_click: || play_index(3)}
        }
        queue := View{
            width: Fill
            height: Fit
            flow: Down
            spacing: 6
            q0 := QueueRow{}
            q1 := QueueRow{}
            q2 := QueueRow{}
            q3 := QueueRow{}
        }
    }
}
