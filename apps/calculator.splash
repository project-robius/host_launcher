// A liquid-glass calculator. All arithmetic stays numeric; display via set_text.
//
// Responsive: the column is capped+centered on wide hosts (Fill{max}), and
// on_app_resize swaps in a compact display + keypad tier when the host is
// short or narrow (fonts can't resize at runtime, so tiers are pre-declared).
//
// The arithmetic needs no permissions at all; only the Copy key touches the
// host (clipboard-write), and it appears exactly while that grant holds.
let acc = 0.0
let stored = 0.0
let op = ""
let fresh = true

fn show(v){
    ui.display.set_text("" + v)
    ui.display_sm.set_text("" + v)
}

fn show_op(o){
    ui.op_label.set_text(o)
    ui.op_label_sm.set_text(o)
}

fn digit(d){
    if fresh { acc = 0.0 fresh = false }
    acc = acc * 10.0 + d
    show(acc)
}

fn set_op(o){
    stored = acc
    op = o
    fresh = true
    show_op(o)
}

fn equals(){
    let r = acc
    if op == "+" { r = stored + acc }
    if op == "-" { r = stored - acc }
    if op == "*" { r = stored * acc }
    if op == "/" {
        if acc == 0.0 { r = 0.0 }
        else { r = stored / acc }
    }
    acc = r
    op = ""
    fresh = true
    show_op("")
    show(r)
}

fn clear_all(){
    acc = 0.0
    stored = 0.0
    op = ""
    fresh = true
    show_op("")
    show(0.0)
}

// The Copy key exists only while clipboard-write is granted: a key that
// silently does nothing reads as a broken calculator.
fn sync_copy(){
    ui.copy_wrap.set_visible(host.has("clipboard-write"))
    ui.copy_btn.set_text("Copy")
}

// The key's own label is the status line; the calculator has nowhere else to
// say a copy went nowhere without stealing the display.
fn flash_copy(msg){
    ui.copy_btn.set_text(msg)
    let _revert = start_timeout(1.2, || ui.copy_btn.set_text("Copy"))
}

fn copy_display(){
    // Asked HERE rather than cached at boot, so a revoked clipboard stops
    // being used the moment the user takes it away.
    if !host.has("clipboard-write") {
        sync_copy()
        return nil
    }
    host.request("clipboard.write", {text: "" + acc}, |r| {
        if !r.is_ok {
            flash_copy("Failed")
            return nil
        }
        flash_copy("Copied")
    })
}

// The host calls this on every grant change while we run (caps is a JSON
// array string), so the Copy key follows the grant without a restart.
fn on_permissions_changed(caps){
    let list = caps.parse_json()
    if !list.is_array() {
        sync_copy()
        return nil
    }
    let allowed = false
    for cap in list {
        if cap == "clipboard-write" { allowed = true }
    }
    ui.copy_wrap.set_visible(allowed)
    ui.copy_btn.set_text("Copy")
}

fn on_app_resize(w, h){
    // One compact tier covers both squeezes: a split pane is usually short
    // OR narrow, and mixing full display with mini keypad looks broken.
    let compact = (h < 520) || (w < 300)
    ui.title_row.set_visible(!compact)
    ui.disp_lg.set_visible(!compact)
    ui.keypad.set_visible(!compact)
    ui.disp_sm.set_visible(compact)
    ui.keypad_sm.set_visible(compact)
}

// `ui` handles only exist after eval, so the first grant sync waits a beat.
let _boot = start_timeout(0.05, || sync_copy())

let CalcButton = glass.GlassButton{
    width: Fill
    height: 54
}
let CalcButtonSm = glass.GlassButton{
    width: Fill
    height: 38
    draw_text +: { text_style: theme.font_bold{font_size: 13} }
}

View{
    width: Fill
    height: Fit
    flow: Down
    align: Align{x: 0.5}

    col := View{
        width: Fill{max: 520.0}
        height: Fit
        flow: Down
        spacing: 10
        padding: 14

        title_row := View{
            width: Fill
            height: Fit
            glass.H1{text: "Calculator"}
        }

        disp_lg := View{
            width: Fill
            height: Fit
            glass.Card{
                width: Fill
                height: Fit
                flow: Right
                align: Align{y: 0.5}
                padding: 16
                op_label := glass.Caption{text: "" width: 30}
                display := Label{
                    text: "0"
                    width: Fill
                    align: Align{x: 1.0}
                    draw_text +: {
                        color: #ffffff
                        text_style: theme.font_bold{font_size: 34}
                    }
                }
                copy_wrap := View{
                    width: Fit
                    height: Fit
                    copy_btn := glass.GlassButton{
                        text: "Copy"
                        width: 58
                        height: 28
                        margin: Inset{left: 12}
                        draw_text +: { text_style: theme.font_regular{font_size: 11} }
                        on_click: || copy_display()
                    }
                }
            }
        }

        keypad := View{
            width: Fill
            height: Fit
            flow: Down
            spacing: 10
            View{width: Fill height: Fit flow: Right spacing: 8
                CalcButton{text: "7" on_click: || digit(7.0)}
                CalcButton{text: "8" on_click: || digit(8.0)}
                CalcButton{text: "9" on_click: || digit(9.0)}
                CalcButton{text: "÷" on_click: || set_op("/")}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                CalcButton{text: "4" on_click: || digit(4.0)}
                CalcButton{text: "5" on_click: || digit(5.0)}
                CalcButton{text: "6" on_click: || digit(6.0)}
                CalcButton{text: "×" on_click: || set_op("*")}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                CalcButton{text: "1" on_click: || digit(1.0)}
                CalcButton{text: "2" on_click: || digit(2.0)}
                CalcButton{text: "3" on_click: || digit(3.0)}
                CalcButton{text: "−" on_click: || set_op("-")}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                CalcButton{text: "C" on_click: || clear_all()}
                CalcButton{text: "0" on_click: || digit(0.0)}
                glass.GlassButtonProminent{width: Fill height: 54 text: "=" on_click: || equals()}
                CalcButton{text: "+" on_click: || set_op("+")}
            }
        }

        // Compact tier: smaller result figure, 38px keys, no title (the host
        // header already names the app). Fits a ~300px-tall split pane with
        // the display and keypad visible together.
        disp_sm := View{
            visible: false
            width: Fill
            height: Fit
            glass.Card{
                width: Fill
                height: Fit
                flow: Right
                align: Align{y: 0.5}
                padding: Inset{top: 10, bottom: 10, left: 12, right: 12}
                op_label_sm := glass.Caption{text: "" width: 20}
                display_sm := Label{
                    text: "0"
                    width: Fill
                    align: Align{x: 1.0}
                    draw_text +: {
                        color: #ffffff
                        text_style: theme.font_bold{font_size: 22}
                    }
                }
            }
        }
        keypad_sm := View{
            visible: false
            width: Fill
            height: Fit
            flow: Down
            spacing: 6
            View{width: Fill height: Fit flow: Right spacing: 6
                CalcButtonSm{text: "7" on_click: || digit(7.0)}
                CalcButtonSm{text: "8" on_click: || digit(8.0)}
                CalcButtonSm{text: "9" on_click: || digit(9.0)}
                CalcButtonSm{text: "÷" on_click: || set_op("/")}
            }
            View{width: Fill height: Fit flow: Right spacing: 6
                CalcButtonSm{text: "4" on_click: || digit(4.0)}
                CalcButtonSm{text: "5" on_click: || digit(5.0)}
                CalcButtonSm{text: "6" on_click: || digit(6.0)}
                CalcButtonSm{text: "×" on_click: || set_op("*")}
            }
            View{width: Fill height: Fit flow: Right spacing: 6
                CalcButtonSm{text: "1" on_click: || digit(1.0)}
                CalcButtonSm{text: "2" on_click: || digit(2.0)}
                CalcButtonSm{text: "3" on_click: || digit(3.0)}
                CalcButtonSm{text: "−" on_click: || set_op("-")}
            }
            View{width: Fill height: Fit flow: Right spacing: 6
                CalcButtonSm{text: "C" on_click: || clear_all()}
                CalcButtonSm{text: "0" on_click: || digit(0.0)}
                glass.GlassButtonProminent{
                    width: Fill
                    height: 38
                    text: "="
                    draw_text +: { text_style: theme.font_bold{font_size: 13} }
                    on_click: || equals()
                }
                CalcButtonSm{text: "+" on_click: || set_op("+")}
            }
        }
    }
}
