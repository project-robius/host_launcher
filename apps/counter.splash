// A tiny counter, mostly here as a deletable "user-installed" sample app.
//
// Responsive: the column is capped+centered on wide hosts (Fill{max}); the
// button row uses Fill widths so it compresses instead of clipping; a compact
// display + stacked-button tier swaps in on very narrow hosts (fonts can't
// resize at runtime); the H1 hides on short hosts since the host header
// already names the app.
//
// The count is shared with the home-screen widget: persisted to /count.json
// on every change, and broadcast over same-app IPC so a live widget isolate
// updates instantly (and vice versa). Both hops carry the count SIGN-SPLIT as
// [is_negative, magnitude]: parse_json has no case for a leading "-", so a
// plain negative number silently loses its whole field on the way back in,
// and the − button walks below zero all the time.
let count = 0

fn show(){
    ui.display.set_text("" + count)
    ui.display_sm.set_text("" + count)
}

// The wire/disk shape, in numbers that always survive a JSON round trip.
fn payload(){
    if count < 0 { return [1, 0 - count] }
    return [0, count]
}

// Reads that shape back into count; false (and no change at all) if the
// value isn't intact, so a bad read can never half-update the counter.
fn take_payload(v){
    if !v.is_array() { return false }
    if !(v.len() == 2) { return false }
    if !v[0].is_number() { return false }
    if !v[1].is_number() { return false }
    let n = v[1]
    if v[0] == 1 { n = 0 - n }
    count = n
    return true
}

fn load(){
    if !fs.exists("/count.json") { return }
    let v = fs.read("/count.json").parse_json()
    if take_payload(v) { return }
    // A file from before the sign split: positive counts still load (a
    // negative one never made it back out), and the next tap rewrites it.
    if !v.is_object() { return }
    if !v.count.is_number() { return }
    count = v.count
}

// Called after every local change: persist FIRST, then nudge the widget's
// isolate — a failed or undelivered send leaves the saved count untouched.
// Same-app IPC needs no permission (docs/PERMISSIONS.md), and there is no
// result to show, so the callback is deliberately nil.
// on_ipc_message deliberately does NOT call this — no echo loops.
fn sync(){
    fs.write("/count.json", payload().to_json())
    host.request("ipc.send", {to: "self", data: payload()}, nil)
}

// The widget bumped the count; data arrives as a JSON string like [0, 3].
fn on_ipc_message(from, data){
    let took = take_payload(data.parse_json())
    if took { show() }
    return nil
}

fn on_app_resize(w, h){
    let narrow = w < 250
    ui.title_row.set_visible(h >= 300)
    ui.disp_lg.set_visible(!narrow)
    ui.disp_sm.set_visible(narrow)
    ui.row_wide.set_visible(!narrow)
    ui.rows_narrow.set_visible(narrow)
}

let _init = load()
let _boot = start_timeout(0.05, || show())

View{
    width: Fill
    height: Fit
    flow: Down
    align: Align{x: 0.5}

    col := View{
        width: Fill{max: 480.0}
        height: Fit
        flow: Down
        spacing: 14
        padding: 16
        align: Align{x: 0.5}

        title_row := View{
            width: Fill
            height: Fit
            align: Align{x: 0.5}
            glass.H1{text: "Counter"}
        }

        disp_lg := View{
            width: Fill
            height: Fit
            glass.Card{
                width: Fill
                height: Fit
                align: Align{x: 0.5, y: 0.5}
                padding: 26
                display := Label{
                    text: "0"
                    draw_text +: {
                        color: #x9dccff
                        text_style: theme.font_bold{font_size: 52}
                    }
                }
            }
        }

        row_wide := View{
            width: Fill
            height: Fit
            flow: Right
            spacing: 10
            glass.GlassButton{text: "−" width: Fill height: 52 on_click: || { count -= 1 show() sync() }}
            glass.GlassButton{text: "Reset" width: Fill height: 52 on_click: || { count = 0 show() sync() }}
            glass.GlassButtonProminent{text: "+" width: Fill height: 52 on_click: || { count += 1 show() sync() }}
        }

        // Narrow tier (w < 250): smaller figure, − and + side by side with
        // Reset on its own line so every button stays tappable at 190w.
        disp_sm := View{
            visible: false
            width: Fill
            height: Fit
            glass.Card{
                width: Fill
                height: Fit
                align: Align{x: 0.5, y: 0.5}
                padding: 14
                display_sm := Label{
                    text: "0"
                    draw_text +: {
                        color: #x9dccff
                        text_style: theme.font_bold{font_size: 30}
                    }
                }
            }
        }
        rows_narrow := View{
            visible: false
            width: Fill
            height: Fit
            flow: Down
            spacing: 8
            View{width: Fill height: Fit flow: Right spacing: 8
                glass.GlassButton{text: "−" width: Fill height: 48 on_click: || { count -= 1 show() sync() }}
                glass.GlassButtonProminent{text: "+" width: Fill height: 48 on_click: || { count += 1 show() sync() }}
            }
            glass.GlassButton{text: "Reset" width: Fill height: 40 on_click: || { count = 0 show() sync() }}
        }
    }
}
