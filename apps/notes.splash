// A simple notes app: write a note, save it, tap a note's number to reopen it.
//
// Responsive: the whole column is capped+centered on wide hosts (Fill{max}),
// and on_app_resize hides our own H1 on short panes — the host's 44px header
// already names the app, so the editor stays above the fold. The editor is a
// single instance (never tiered — duplicating a TextInput would desync text).
let notes = [
    {title: "Welcome" body: "This whole app is a Splash script running in its own isolated VM inside the launcher."}
]

fn refresh(){
    ui.note_list.render()
}

fn save_note(){
    let body = ("" + ui.editor.text()).trim()
    if body == "" { return }
    let title = body
    if title.len() > 24 {
        title = ""
        let count = 0
        for ch in body.to_chars() {
            if count < 24 { title = title + ch }
            count += 1
        }
        title = title + "…"
    }
    notes.push({title: title body: body})
    ui.editor.set_text("")
    refresh()
}

fn on_app_resize(w, h){
    ui.title_row.set_visible(h >= 400)
}

let _boot = start_timeout(0.05, || refresh())

View{
    width: Fill
    height: Fit
    flow: Down
    align: Align{x: 0.5}

    col := View{
        width: Fill{max: 560.0}
        height: Fit
        flow: Down
        spacing: 12
        padding: 14

        title_row := View{
            width: Fill
            height: Fit
            glass.H1{text: "Notes"}
        }

        glass.Card{
            width: Fill
            height: Fit
            flow: Down
            spacing: 8
            glass.Caption{text: "NEW NOTE"}
            editor := glass.TextInput{
                width: Fill
                height: 76
                empty_text: "Write something..."
            }
            View{
                width: Fill
                height: Fit
                flow: Right
                spacing: 8
                View{width: Fill height: 1}
                glass.GlassButtonProminent{text: "Save" width: 84 height: 38 on_click: || save_note()}
            }
        }

        glass.Caption{text: "SAVED NOTES"}
        note_list := View{
            width: Fill
            height: Fit
            flow: Down
            spacing: 8
            on_render: || {
                // Indexed while + plain RoundedView roots: kept for
                // debuggability (the old emission bugs are fixed upstream,
                // SPLASH_FINDINGS #12).
                let n = notes.len()
                let i = 0
                while i < n {
                    let note = notes[i]
                    RoundedView{
                        width: Fill
                        height: Fit
                        flow: Down
                        spacing: 5
                        padding: 14.0
                        margin: Inset{top: 4.0}
                        new_batch: true
                        show_bg: true
                        draw_bg +: {
                            color: #xffffff10
                            border_radius: 12.0
                        }
                        glass.H2{text: note.title}
                        glass.Body{text: note.body width: Fill}
                    }
                    i += 1
                }
            }
        }
    }
}
