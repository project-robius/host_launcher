// The Weather home-screen widget: current conditions at a glance.
//
// The host calls on_widget_resize(cols, rows, w, h) whenever the tile's size
// changes, and the widget reflows: a one-line compact form at single-row
// height, the full stack at two-plus rows, and a 5-day forecast strip once
// there's three-plus columns of width for it.
//
// Live mode: boot adopts the app's cached /weather.json (one shared jail),
// and with the "network" grant (shared with the app; widgets never prompt)
// the widget also refreshes that cache itself: env -> host location (San
// Francisco's coordinates on denial/error) -> Open-Meteo, written back in
// the app's full day shape. With no grants and no cache the static mock
// text below renders untouched.
//
// Grants move under us too: on_permissions_changed drops the tracked place
// name when `location` goes away and re-runs a fallback fetch when it
// arrives (a `network` change drops and rebuilds this tile instead).
let city = ""
let wdays = []
// True while what's on screen came from the SF fallback, so a location grant
// arriving mid-session knows there is something worth re-fetching.
let loc_fallback = false
let day_names = ["Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat"]
let day_fulls = ["Sunday" "Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday"]

// ASCII uppercase (the dialect has no case helpers); other chars pass through.
fn upcase(s){
    let lo = "abcdefghijklmnopqrstuvwxyz".split("")
    let up = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("")
    let out = ""
    for c in ("" + s).split("") {
        let u = c
        let i = 0
        while i < lo.len() {
            if c == lo[i] { u = up[i] }
            i += 1
        }
        out = out + u
    }
    return out
}

// Zeller's congruence (calendar.splash's math for an arbitrary day), 0 = Sunday.
fn weekday(y, m, d){
    let mm = m
    let yy = y
    if mm < 3 {
        mm += 12
        yy -= 1
    }
    let k = yy % 100
    let j = floor(yy / 100)
    let h = (d + floor((13.0 * (mm + 1)) / 5.0) + k + floor(k / 4.0) + floor(j / 4.0) + 5 * j) % 7
    return (h + 6) % 7
}

// WMO weather_code -> the app's cond/icon vocabulary (gaps lean nearest).
fn code_icon(c){
    if c == 0 { return "☀️" }
    if c <= 2 { return "⛅" }
    if c <= 44 { return "☁️" }
    if c <= 48 { return "🌫" }
    if c <= 70 { return "🌧" }
    if c <= 77 { return "❄️" }
    if c <= 94 { return "🌧" }
    return "⛈"
}

fn code_cond(c){
    if c == 0 { return "Sunny" }
    if c <= 2 { return "Partly Cloudy" }
    if c <= 44 { return "Cloudy" }
    if c <= 48 { return "Fog" }
    if c <= 70 { return "Rain" }
    if c <= 77 { return "Snow" }
    if c <= 94 { return "Rain" }
    return "Storm"
}

// A numeric element or the default: forecast rows can carry JSON nulls, and
// nil arithmetic would poison every temperature built from them.
fn num_at(arr, i, dflt){
    if i >= arr.len() { return dflt }
    let v = arr[i]
    if v.is_nil() { return dflt }
    return v
}

// Six bar temps for day `di` (indexes 6,9,12,15,18,21 of its 24 hourly
// values) — cached so the fullscreen app can reuse this widget's fetch.
fn pick_hours(temps, di){
    let hrs = []
    let k = 0
    while k < 6 {
        let idx = di * 24 + 6 + k * 3
        let r = floor(num_at(temps, idx, 50) + 0.5)
        hrs.push(r)
        k += 1
    }
    return hrs
}

// A daily column that actually covers the five days we show. Server JSON is
// read by INDEX, never `dl.name`: a missing key traps on dot access, so the
// guard itself would be the thing that breaks on a surprise payload.
fn ok_col(dl, name){
    let col = dl[name]
    if !col.is_array() { return false }
    if col.len() < 5 { return false }
    return true
}

// Open-Meteo daily+hourly blocks -> five entries in the app's day shape.
fn build_days(dl, temps){
    let times = dl["time"]
    let codes = dl["weather_code"]
    let maxs = dl["temperature_2m_max"]
    let mins = dl["temperature_2m_min"]
    let out = []
    let di = 0
    while di < 5 {
        let parts = ("" + times[di]).split("-")
        let wd = 0
        if parts.len() == 3 { wd = weekday(parts[0].to_f64(), parts[1].to_f64(), parts[2].to_f64()) }
        let code = num_at(codes, di, 0)
        let hi = floor(num_at(maxs, di, 50) + 0.5)
        let lo = floor(num_at(mins, di, 50) + 0.5)
        let hrs = pick_hours(temps, di)
        out.push({name: day_names[wd] full: day_fulls[wd] hi: hi lo: lo cond: code_cond(code) icon: code_icon(code) hours: hrs})
        di += 1
    }
    return out
}

// Pour today + the 5-day strip into the pre-declared labels. Only ever
// called once real (cached or fetched) data is in hand, so the no-grant
// no-cache boot leaves the static mock text byte-identical.
fn sync_widget(){
    if wdays.len() < 5 { return }
    let d0 = wdays[0]
    let place = "San Francisco"
    if city.len() > 0 { place = "" + city }
    ui.w_icon_sm.set_text(d0.icon)
    ui.w_temp_sm.set_text("" + d0.hi + "°")
    ui.w_city_sm.set_text(place)
    ui.w_icon.set_text(d0.icon)
    ui.w_temp.set_text("" + d0.hi + "°")
    ui.w_city.set_text(place)
    ui.w_hl.set_text("H:" + d0.hi + "° L:" + d0.lo + "°")
    ui.f0_n.set_text(upcase(wdays[0].name))
    ui.f0_i.set_text(wdays[0].icon)
    ui.f0_h.set_text("" + wdays[0].hi + "°")
    ui.f1_n.set_text(upcase(wdays[1].name))
    ui.f1_i.set_text(wdays[1].icon)
    ui.f1_h.set_text("" + wdays[1].hi + "°")
    ui.f2_n.set_text(upcase(wdays[2].name))
    ui.f2_i.set_text(wdays[2].icon)
    ui.f2_h.set_text("" + wdays[2].hi + "°")
    ui.f3_n.set_text(upcase(wdays[3].name))
    ui.f3_i.set_text(wdays[3].icon)
    ui.f3_h.set_text("" + wdays[3].hi + "°")
    ui.f4_n.set_text(upcase(wdays[4].name))
    ui.f4_i.set_text(wdays[4].icon)
    ui.f4_h.set_text("" + wdays[4].hi + "°")
}

// Every cached day is dot-read by sync_widget, so the whole shape is checked
// before adoption rather than trapping mid-repaint on a half-written file.
// Same shape the app validates: one cache, one writer format.
fn ok_day(d){
    if !d.is_object() { return false }
    let h = d["hours"]
    if !h.is_array() { return false }
    if h.len() < 6 { return false }
    if d["name"].is_nil() { return false }
    if d["full"].is_nil() { return false }
    if d["hi"].is_nil() { return false }
    if d["lo"].is_nil() { return false }
    if d["cond"].is_nil() { return false }
    if d["icon"].is_nil() { return false }
    return true
}

// A /weather.json cached by an earlier online run (ours or the app's — one
// shared jail) supplies real data on a netless boot. Reading our own jail
// needs no grant, so this is the path a revoked `network` lands on.
fn load_cache(){
    if !fs.exists("/weather.json") { return }
    let parsed = fs.read("/weather.json").parse_json()
    if !parsed.is_object() { return }
    let cached = parsed["days"]
    if !cached.is_array() { return }
    if cached.len() < 5 { return }
    let i = 0
    while i < 5 {
        if !ok_day(cached[i]) { return }
        i += 1
    }
    wdays = cached
    let c = parsed["city"]
    if !c.is_nil() { city = "" + c }
}

// Adopt a fetched forecast: rewrite the cache for the app+widget pair and
// repaint. Any shape surprise bails out and leaves what's on screen alone.
fn apply_weather(v, cty){
    if !v.is_object() { return }
    let dl = v["daily"]
    if !dl.is_object() { return }
    let hr = v["hourly"]
    if !hr.is_object() { return }
    if !ok_col(dl, "time") { return }
    if !ok_col(dl, "weather_code") { return }
    if !ok_col(dl, "temperature_2m_max") { return }
    if !ok_col(dl, "temperature_2m_min") { return }
    let temps = hr["temperature_2m"]
    if !temps.is_array() { return }
    wdays = build_days(dl, temps)
    if cty.len() > 0 { city = cty }
    fs.write("/weather.json", {city: city days: wdays}.to_json())
    sync_widget()
}

fn fetch_weather(wurl, lat, lon, cty){
    // Re-checked HERE, at the call, never cached from boot: the location
    // round trip is async and mod.net traps in an isolate without the grant.
    if !host.has("network") { return }
    let url = wurl + "?latitude=" + lat + "&longitude=" + lon + "&daily=weather_code,temperature_2m_max,temperature_2m_min&hourly=temperature_2m&forecast_days=5&timezone=auto"
    mod.net.http_request(mod.net.HttpRequest{url: url}, mod.net.HttpEvents{
        on_response: |res| {
            if !(res.status_code == 200) { return }
            if res.body.is_nil() { return }
            apply_weather(res.body.parse_json(), cty)
        }
        on_error: |_err| nil
    })
}

// lat/lon/city out of a location answer, or nil when there is no usable fix:
// denied, revoked mid-flight, or a payload that isn't the shape we expect.
fn loc_of(rl){
    if !rl.is_ok { return nil }
    if !rl.data.is_object() { return nil }
    // By index: `city` is optional in the service contract, and a dot read of
    // a key the payload doesn't carry traps instead of answering nil.
    let lat = rl.data["lat"]
    let lon = rl.data["lon"]
    if lat.is_nil() { return nil }
    if lon.is_nil() { return nil }
    let cty = ""
    let c = rl.data["city"]
    if !c.is_nil() { cty = "" + c }
    return {lat: lat lon: lon city: cty}
}

// env endpoints, then a host location (an Ask-state widget's request just
// fails — no prompt — and San Francisco's coordinates stand in), then the
// forecast itself. Safe to re-run: it re-checks every grant it needs.
fn start_fetch(){
    host.request("env", nil, |r| {
        if !r.is_ok { return }
        if !r.data.is_object() { return }
        let wurl_v = r.data["weather_url"]
        if wurl_v.is_nil() { return }
        // Never touch mod.net in a netless isolate — it traps.
        if !host.has("network") { return }
        let wurl = "" + wurl_v
        host.request("location.get", {}, |rl| {
            let fix = loc_of(rl)
            // No fix = the SF fallback forecast, captioned SF, or a stale
            // place name would caption somebody else's coordinates.
            let lat = 37.77
            let lon = -122.42
            let cty = "San Francisco"
            loc_fallback = true
            if !fix.is_nil() {
                lat = fix.lat
                lon = fix.lon
                cty = fix.city
                loc_fallback = false
            }
            fetch_weather(wurl, lat, lon, cty)
        })
    })
}

// Membership test on the JSON array string the host hands the hook below.
fn has_cap(caps, name){
    let list = caps.parse_json()
    if !list.is_array() { return false }
    let i = 0
    while i < list.len() {
        if ("" + list[i]) == name { return true }
        i += 1
    }
    return false
}

// The host calls this on every live isolate of the app — this tile included —
// when its grants move (`network` drops and rebuilds the tile instead).
fn on_permissions_changed(caps){
    let has_loc = has_cap(caps, "location")
    // Revoked: forget the tracked place name, but repaint nothing and fake no
    // fetch — the temperature showing is still the data we fetched. The next
    // refresh relabels it to the fallback city.
    // Also mark what's on screen as fallback-labelled: it is now captioned
    // SAN FRANCISCO, so a later re-grant must re-fetch to make the caption
    // true again rather than leaving real-location data under the wrong name.
    if !has_loc {
        city = ""
        loc_fallback = true
    }
    // Granted mid-session (usually the user answering the app's prompt): the
    // tile picks it up itself instead of waiting for a home-screen rebuild.
    if has_loc && loc_fallback { start_fetch() }
    return nil
}

fn on_widget_resize(cols, rows, w, h){
    // A wide two-row tile pairs the horizontal hero with the forecast strip;
    // the full vertical stack needs three rows to sit above the forecast.
    // (Locals kept for readability; the old VM bug where an inline `&&`/`||`
    // in argument position lost its value has been fixed in makepad's parser.)
    let compact = rows < 2
    let hero_row = (rows >= 2) && (rows < 3) && (cols >= 3)
    let show_compact = compact || hero_row
    let show_full = (rows >= 3) || ((rows >= 2) && (cols < 3))
    let show_forecast = (rows >= 2) && (cols >= 3)
    ui.r_compact.set_visible(show_compact)
    ui.r_full.set_visible(show_full)
    ui.r_forecast.set_visible(show_forecast)
}

let _init = load_cache()
let _boot = start_timeout(0.05, || {
    sync_widget()
    start_fetch()
})

let DayName = Label{
    draw_text +: {
        color: #xd9e8ffcc
        text_style: theme.font_bold{font_size: 10}
    }
}
let DayIcon = Label{
    draw_text +: {
        color: #ffffff
        text_style: theme.font_regular{font_size: 15}
    }
}
let DayHi = Label{
    draw_text +: {
        color: #ffffff
        text_style: theme.font_bold{font_size: 11}
    }
}

View{
    width: Fill
    height: Fit
    flow: Down
    spacing: 6
    align: Align{x: 0.5, y: 0.5}
    // Keep the widget's content clear of the tile border.
    padding: Inset{left: 10, right: 10, top: 4, bottom: 8}

    // Single-row height: icon and temperature side by side, nothing else.
    r_compact := View{
        visible: false
        width: Fit
        height: Fit
        flow: Right
        spacing: 8
        align: Align{y: 0.5}
        w_icon_sm := Label{
            text: "☀️"
            draw_text +: {
                color: #ffffff
                text_style: theme.font_regular{font_size: 20}
            }
        }
        w_temp_sm := Label{
            text: "78°"
            draw_text +: {
                color: #ffffff
                text_style: theme.font_bold{font_size: 22}
            }
        }
        w_city_sm := Label{
            text: "San Francisco"
            margin: Inset{left: 4}
            draw_text +: {
                color: #xd9e8ffcc
                text_style: theme.font_bold{font_size: 10}
            }
        }
    }

    // The canonical 2x2 stack.
    r_full := View{
        width: Fit
        height: Fit
        flow: Down
        spacing: 3
        align: Align{x: 0.5}
        w_icon := Label{
            text: "☀️"
            draw_text +: {
                color: #ffffff
                text_style: theme.font_regular{font_size: 26}
            }
        }
        w_temp := Label{
            text: "78°"
            draw_text +: {
                color: #ffffff
                text_style: theme.font_bold{font_size: 24}
            }
        }
        w_city := Label{
            text: "San Francisco"
            draw_text +: {
                color: #xd9e8ffcc
                text_style: theme.font_bold{font_size: 10}
            }
        }
        w_hl := Label{
            text: "H:78° L:56°"
            draw_text +: {
                color: #x9dccffcc
                text_style: theme.font_regular{font_size: 10}
            }
        }
    }

    // A 5-day strip shown when the tile is at least 3 columns wide.
    r_forecast := View{
        visible: false
        width: Fill
        height: Fit
        flow: Right
        margin: Inset{top: 4}
        View{width: Fill height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
            f0_n := DayName{text: "MON"} f0_i := DayIcon{text: "☀️"} f0_h := DayHi{text: "78°"}
        }
        View{width: Fill height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
            f1_n := DayName{text: "TUE"} f1_i := DayIcon{text: "⛅"} f1_h := DayHi{text: "74°"}
        }
        View{width: Fill height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
            f2_n := DayName{text: "WED"} f2_i := DayIcon{text: "🌧"} f2_h := DayHi{text: "66°"}
        }
        View{width: Fill height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
            f3_n := DayName{text: "THU"} f3_i := DayIcon{text: "⛅"} f3_h := DayHi{text: "70°"}
        }
        View{width: Fill height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
            f4_n := DayName{text: "FRI"} f4_i := DayIcon{text: "☀️"} f4_h := DayHi{text: "77°"}
        }
    }
}
