// A mock news reader: headline list with a tap-to-read detail view.
let stories = [
    {cat: "TECH" age: "2h ago" icon: "🍎" title: "Apple Unveils New AI-Powered MacOS Features"
     body: "The new release integrates on-device models across the system, with live summarization and a redesigned assistant."}
    {cat: "FINANCE" age: "3h ago" icon: "📈" title: "Global Markets Rally on Trade Deal Optimism"
     body: "Equities climbed across every major index as negotiators signaled a breakthrough on long-stalled trade talks."}
    {cat: "SCIENCE" age: "5h ago" icon: "🚀" title: "NASA Confirms Water Ice Deposits on Mars Surface"
     body: "Radar data from the latest orbiter pass shows extensive shallow ice sheets near the equator, a boon for future missions."}
    {cat: "SPORTS" age: "6h ago" icon: "🚴" title: "Tour de France Stage 13: Dramatic Mountain Finish"
     body: "A late solo attack on the final climb overturned the general classification in one of the closest stages in years."}
    {cat: "WORLD" age: "8h ago" icon: "🌍" title: "EU Passes Landmark Digital Privacy Regulation"
     body: "The sweeping rules set new limits on data collection and give users a right to algorithmic transparency."}
    {cat: "WEATHER" age: "10h ago" icon: "🌡" title: "Record Heatwave Expected Across Southern Europe"
     body: "Forecasters warn of temperatures topping 44°C this weekend, prompting health alerts in a dozen cities."}
]
let reading = -1

fn show_list(){
    reading = -1
    ui.content.render()
}

let _boot = start_timeout(0.05, || ui.content.render())

fn read(i){
    reading = i
    ui.content.render()
}

View{
    width: Fill
    height: Fit
    flow: Down
    spacing: 12
    padding: 14

    View{
        width: Fill
        height: Fit
        flow: Right
        align: Align{y: 0.5}
        glass.H1{text: "📰 News"}
        View{width: Fill height: 1}
        date_label := glass.Caption{text: "TODAY"}
    }

    content := View{
        width: Fill
        height: Fit
        flow: Down
        spacing: 10
        on_render: || {
            if reading < 0 {
                for story in stories {
                    glass.Card{
                        width: Fill
                        height: Fit
                        flow: Right
                        spacing: 12
                        align: Align{y: 0.5}
                        Label{
                            text: story.icon
                            draw_text +: {
                                color: #ffffff
                                text_style: theme.font_regular{font_size: 22}
                            }
                        }
                        View{
                            width: Fill
                            height: Fit
                            flow: Down
                            spacing: 4
                            glass.Caption{text: story.cat + "  ·  " + story.age}
                            glass.Body{text: story.title}
                        }
                    }
                }
                // Build-time loop, so per-story taps use index buttons below.
                glass.Caption{text: "TAP A NUMBER TO READ"}
                View{
                    width: Fill
                    height: Fit
                    flow: Right
                    spacing: 8
                    glass.GlassButton{text: "1" width: Fill height: 40 on_click: || read(0)}
                    glass.GlassButton{text: "2" width: Fill height: 40 on_click: || read(1)}
                    glass.GlassButton{text: "3" width: Fill height: 40 on_click: || read(2)}
                    glass.GlassButton{text: "4" width: Fill height: 40 on_click: || read(3)}
                    glass.GlassButton{text: "5" width: Fill height: 40 on_click: || read(4)}
                    glass.GlassButton{text: "6" width: Fill height: 40 on_click: || read(5)}
                }
            }
            else {
                let story = stories[reading]
                glass.Card{
                    width: Fill
                    height: Fit
                    flow: Down
                    spacing: 10
                    padding: 18
                    glass.Caption{text: story.cat + "  ·  " + story.age}
                    glass.H2{text: story.title}
                    glass.Body{text: story.body}
                }
                glass.GlassButton{text: "‹ Back to headlines" height: 42 on_click: || show_list()}
            }
        }
    }
}
