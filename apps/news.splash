// A news reader: headline list with a tap-to-read detail view.
//
// Live mode: at boot the app asks the host for its env (endpoint URLs come
// ONLY from there), and if the "network" capability is granted it fetches
// env.news_url (HN Algolia shape), maps the hits into `stories`, resyncs the
// fixed card slots below, and badges the app icon with the story count. With
// no grants — or any fetch/parse failure — the hardcoded mock stories stay
// on screen untouched, so the app is fully usable with zero permissions.
//
// Responsive: the whole column is capped+centered on wide hosts (Fill{max}),
// the number buttons re-chunk into shorter rows when narrow via
// buttons.on_render, and the app's own title row hides on short hosts (the
// host header already names the app).
//
// Permissions are re-checked at USE time (never cached from boot) and
// on_permissions_changed re-syncs the detail view, so revoking open-url or
// notifications mid-session takes effect without a restart.
let stories = [
    {cat: "TECH" age: "2h ago" icon: "🍎" url: "" title: "Apple Unveils New AI-Powered MacOS Features"
     body: "The new release integrates on-device models across the system, with live summarization and a redesigned assistant."}
    {cat: "FINANCE" age: "3h ago" icon: "📈" url: "" title: "Global Markets Rally on Trade Deal Optimism"
     body: "Equities climbed across every major index as negotiators signaled a breakthrough on long-stalled trade talks."}
    {cat: "SCIENCE" age: "5h ago" icon: "🚀" url: "" title: "NASA Confirms Water Ice Deposits on Mars Surface"
     body: "Radar data from the latest orbiter pass shows extensive shallow ice sheets near the equator, a boon for future missions."}
    {cat: "SPORTS" age: "6h ago" icon: "🚴" url: "" title: "Tour de France Stage 13: Dramatic Mountain Finish"
     body: "A late solo attack on the final climb overturned the general classification in one of the closest stages in years."}
    {cat: "WORLD" age: "8h ago" icon: "🌍" url: "" title: "EU Passes Landmark Digital Privacy Regulation"
     body: "The sweeping rules set new limits on data collection and give users a right to algorithmic transparency."}
    {cat: "WEATHER" age: "10h ago" icon: "🌡" url: "" title: "Record Heatwave Expected Across Southern Europe"
     body: "Forecasters warn of temperatures topping 44°C this weekend, prompting health alerts in a dozen cities."}
]
let reading = -1
let app_w = 400.0
let app_h = 730.0
let news_url = ""
let live_icons = ["📰" "💬" "🔥" "🧪" "💡" "🌐"]
// Badge bookkeeping: only a live fetch earns a badge, and reading retires it.
let live_count = 0
let badge_wanted = false

fn cap_of(s){ return s.icon + "  " + s.cat + " · " + s.age }

// Fixed-slot sync: pour `stories` into the six pre-declared cards (no
// dynamic widget creation), hide unused slots, re-chunk the number buttons.
fn sync_cards(){
    let n = stories.len()
    ui.slot_0.set_visible(n > 0)
    ui.slot_1.set_visible(n > 1)
    ui.slot_2.set_visible(n > 2)
    ui.slot_3.set_visible(n > 3)
    ui.slot_4.set_visible(n > 4)
    ui.slot_5.set_visible(n > 5)
    if n > 0 { ui.card_0.cap.set_text(cap_of(stories[0])) ui.card_0.headline.set_text(stories[0].title) }
    if n > 1 { ui.card_1.cap.set_text(cap_of(stories[1])) ui.card_1.headline.set_text(stories[1].title) }
    if n > 2 { ui.card_2.cap.set_text(cap_of(stories[2])) ui.card_2.headline.set_text(stories[2].title) }
    if n > 3 { ui.card_3.cap.set_text(cap_of(stories[3])) ui.card_3.headline.set_text(stories[3].title) }
    if n > 4 { ui.card_4.cap.set_text(cap_of(stories[4])) ui.card_4.headline.set_text(stories[4].title) }
    if n > 5 { ui.card_5.cap.set_text(cap_of(stories[5])) ui.card_5.headline.set_text(stories[5].title) }
    ui.buttons.render()
}

fn set_status(msg){
    ui.det_status.set_text(msg)
    ui.det_status_wrap.set_visible(msg != "")
}

// The button exists only for a live story WITH a url AND the open-url grant
// as of right now; nothing about it is remembered from boot.
fn sync_open_button(){
    if reading < 0 {
        ui.det_open_wrap.set_visible(false)
        return nil
    }
    if reading >= stories.len() {
        ui.det_open_wrap.set_visible(false)
        return nil
    }
    let can = false
    if stories[reading].url != "" { can = host.has("open-url") }
    ui.det_open_wrap.set_visible(can)
}

// Badges are fire-and-forget, so the gate is all that stops a revoked
// notifications grant from firing requests the host can only refuse.
fn post_badge(){
    if !badge_wanted { return nil }
    if live_count < 1 { return nil }
    if !host.has("notifications") { return nil }
    host.request("notify.post", {count: live_count}, nil)
}

fn clear_badge(){
    badge_wanted = false
    if !host.has("notifications") { return nil }
    host.request("notify.clear", {}, nil)
}

fn show_list(){
    reading = -1
    set_status("")
    ui.content.set_visible(true)
    ui.detail.set_visible(false)
}

fn read(i){
    if i >= stories.len() { return }
    reading = i
    let story = stories[i]
    ui.det_cap.set_text(story.cat + "  ·  " + story.age)
    ui.det_title.set_text(story.title)
    ui.det_body.set_text(story.body)
    set_status("")
    // Only live stories carry a real url; mock ones keep the button hidden.
    sync_open_button()
    ui.content.set_visible(false)
    ui.detail.set_visible(true)
    // Reading the news clears the unread badge — but never prompts for it.
    clear_badge()
}

fn open_link(){
    if reading < 0 { return }
    if reading >= stories.len() { return }
    let story = stories[reading]
    if story.url == "" { return }
    // Re-check at the moment of use: the grant may have gone away since the
    // detail view was drawn, and the button is hidden the moment we notice.
    if !host.has("open-url") {
        set_status("Opening links is turned off for News.")
        sync_open_button()
        return
    }
    set_status("Opening…")
    host.request("url.open", {url: story.url}, |r| {
        if r.is_ok {
            set_status("")
            return nil
        }
        let why = "Couldn't open the link."
        if !r.error.is_nil() { why = "Couldn't open the link: " + ("" + r.error) }
        set_status(why)
        sync_open_button()
    })
}

// The host pushes the new capability list into every live isolate instead of
// restarting (network changes DO restart, so boot re-runs for those).
fn on_permissions_changed(caps){
    let list = caps.parse_json()
    if !list.is_array() { return nil }
    let may_open = false
    let may_notify = false
    for c in list {
        if c == "open-url" { may_open = true }
        if c == "notifications" { may_notify = true }
    }
    sync_open_button()
    if may_notify { post_badge() }
    if reading < 0 { return nil }
    if reading >= stories.len() { return nil }
    if may_open {
        set_status("")
        return nil
    }
    if stories[reading].url != "" { set_status("Opening links is turned off for News.") }
    return nil
}

// Map an HN Algolia response into `stories`. Any shape surprise bails out
// and leaves the mock stories in place.
fn apply_hits(v){
    if !v.is_object() { return }
    if !v.hits.is_array() { return }
    let fresh = []
    for h in v.hits {
        if fresh.len() < 6 {
            if !h.title.is_nil() {
                let url = ""
                if !h.url.is_nil() { url = "" + h.url }
                let age = ""
                if !h.points.is_nil() { age = ("" + h.points) + " pts" } else { if !h.author.is_nil() { age = "" + h.author } }
                fresh.push({cat: "HN" age: age icon: live_icons[fresh.len()] url: url title: "" + h.title body: url})
            }
        }
    }
    if fresh.len() == 0 { return }
    stories = fresh
    live_count = fresh.len()
    badge_wanted = true
    sync_cards()
    // The story list changed under the detail view; re-sync what it offers.
    sync_open_button()
    post_badge()
}

fn fetch_news(){
    mod.net.http_request(mod.net.HttpRequest{url: news_url}, mod.net.HttpEvents{
        on_response: |res| {
            if res.status_code != 200 { return nil }
            if res.body.is_nil() { return nil }
            apply_hits(res.body.parse_json())
        }
        on_error: |_e| nil
    })
}

fn boot(){
    sync_cards()
    // Early returns, not nested if tails: an if as a closure's FINAL
    // statement lands in expression position and fails to parse.
    host.request("env", nil, |r| {
        if !r.is_ok { return nil }
        if !r.data.is_object() { return nil }
        if !r.data.news_url.is_nil() { news_url = "" + r.data.news_url }
        if news_url == "" { return nil }
        // Never touch mod.net in a netless isolate — it traps.
        if !host.has("network") { return nil }
        fetch_news()
    })
}

fn on_app_resize(w, h){
    app_w = w
    app_h = h
    ui.title_row.set_visible(h >= 350)
    ui.buttons.render()
}

let NewsCard = glass.Card{
    width: Fill
    height: Fit
    flow: Down
    spacing: 4
    cap := glass.Caption{text: ""}
    headline := glass.Body{text: "" width: Fill}
}

let _boot = start_timeout(0.05, || boot())

View{
    width: Fill
    height: Fit
    flow: Down
    align: Align{x: 0.5}

    col := View{
        width: Fill{max: 640.0}
        height: Fit
        flow: Down
        spacing: 12
        padding: 14

        title_row := View{
            width: Fill
            height: Fit
            flow: Right
            align: Align{y: 0.5}
            glass.H1{text: "📰 News"}
            View{width: Fill height: 1}
            date_label := glass.Caption{text: "TODAY"}
        }

        content := View{
            width: Fill
            height: Fit
            flow: Down
            spacing: 10

            glass.Caption{text: "TAP A NUMBER TO READ"}
            buttons := View{
                width: Fill
                height: Fit
                flow: Down
                spacing: 8
                on_render: || {
                    // Chunked by width; plain-View rows with GlassButton
                    // children (simple single-path emission — see
                    // SPLASH_FINDINGS #12). A live fetch may hand us fewer
                    // than 6 stories, so the count comes from the array.
                    let n = stories.len()
                    let per = 6
                    if app_w < 340.0 { per = 3 }
                    if app_w < 250.0 { per = 2 }
                    let b = 0
                    while b < n {
                        View{
                            width: Fill
                            height: Fit
                            flow: Right
                            spacing: 8.0
                            margin: Inset{top: 8.0}
                            let k = 0
                            while k < per {
                                let idx = b + k
                                if idx < n {
                                    glass.GlassButton{text: ("" + (idx + 1)) width: Fill height: 40 on_click: || read(idx)}
                                }
                                k += 1
                            }
                        }
                        b += per
                    }
                }
            }

            slot_0 := View{
                width: Fill
                height: Fit
                card_0 := NewsCard{
                    cap.text: "🍎  TECH · 2h ago"
                    headline.text: "Apple Unveils New AI-Powered MacOS Features"
                }
            }
            slot_1 := View{
                width: Fill
                height: Fit
                card_1 := NewsCard{
                    cap.text: "📈  FINANCE · 3h ago"
                    headline.text: "Global Markets Rally on Trade Deal Optimism"
                }
            }
            slot_2 := View{
                width: Fill
                height: Fit
                card_2 := NewsCard{
                    cap.text: "🚀  SCIENCE · 5h ago"
                    headline.text: "NASA Confirms Water Ice Deposits on Mars Surface"
                }
            }
            slot_3 := View{
                width: Fill
                height: Fit
                card_3 := NewsCard{
                    cap.text: "🚴  SPORTS · 6h ago"
                    headline.text: "Tour de France Stage 13: Dramatic Mountain Finish"
                }
            }
            slot_4 := View{
                width: Fill
                height: Fit
                card_4 := NewsCard{
                    cap.text: "🌍  WORLD · 8h ago"
                    headline.text: "EU Passes Landmark Digital Privacy Regulation"
                }
            }
            slot_5 := View{
                width: Fill
                height: Fit
                card_5 := NewsCard{
                    cap.text: "🌡  WEATHER · 10h ago"
                    headline.text: "Record Heatwave Expected Across Southern Europe"
                }
            }
        }

        detail := View{
            visible: false
            width: Fill
            height: Fit
            flow: Down
            spacing: 10
            glass.Card{
                width: Fill
                height: Fit
                flow: Down
                spacing: 10
                padding: 18
                det_cap := glass.Caption{text: ""}
                det_title := glass.H2{text: "" width: Fill}
                det_body := glass.Body{text: "" width: Fill}
            }
            det_status_wrap := View{
                visible: false
                width: Fill
                height: Fit
                det_status := glass.Caption{text: "" width: Fill}
            }
            det_open_wrap := View{
                visible: false
                width: Fill
                height: Fit
                glass.GlassButtonProminent{text: "Open in Browser ↗" width: Fill height: 42 on_click: || open_link()}
            }
            glass.GlassButton{text: "‹ Back to headlines" height: 42 on_click: || show_list()}
        }
    }
}
