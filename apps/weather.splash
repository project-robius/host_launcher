// A weather app: tap a day chip to see its forecast and hourly bars.
//
// Live mode: at boot the app asks the host for its env (endpoint URLs come
// ONLY from there), and if the "network" capability is granted it asks the
// host for a location — falling back to San Francisco's coordinates when
// that's denied or fails — fetches an Open-Meteo forecast, maps the WMO
// weather codes onto the mock cond/icon vocabulary below, rewrites `days`,
// and caches it all to /weather.json (one jail shared with the widget).
// With no grants — or any fetch/parse failure — the mock days stay on
// screen untouched, so the app is fully usable with zero permissions.
//
// Grants can move while we run: `location` is runtime-tier, so
// on_permissions_changed drops the tracked place name when it goes away and
// re-runs a fallback fetch when it arrives (a `network` change restarts us).
//
// Responsive: the column is capped+centered on wide hosts (Fill{max}); chips,
// hero card, and hourly bars all live in on_render so their layout, labels,
// and bar widths re-derive from host_w/host_h on every render. on_app_resize
// stores the size, hides the H1 on short hosts, and re-renders everything.
let days = [
    {name: "Mon" full: "Monday" hi: 78 lo: 56 cond: "Sunny" icon: "☀️" hours: [56 64 74 78 72 60]}
    {name: "Tue" full: "Tuesday" hi: 74 lo: 55 cond: "Partly Cloudy" icon: "⛅" hours: [55 61 70 74 69 58]}
    {name: "Wed" full: "Wednesday" hi: 68 lo: 53 cond: "Cloudy" icon: "☁️" hours: [53 58 64 68 63 55]}
    {name: "Thu" full: "Thursday" hi: 62 lo: 51 cond: "Rain" icon: "🌧" hours: [51 54 59 62 58 52]}
    {name: "Fri" full: "Friday" hi: 80 lo: 58 cond: "Sunny" icon: "☀️" hours: [58 66 76 80 74 62]}
]
let hour_names = ["06:00" "09:00" "12:00" "15:00" "18:00" "21:00"]
let hour_names_sm = ["6a" "9a" "12p" "3p" "6p" "9p"]
let selected = 0
let host_w = 400.0
let host_h = 730.0
// Live/cached place name; "" keeps the mock SAN FRANCISCO subtitle.
let city = ""
// True while what's on screen came from the SF fallback, so a location grant
// arriving mid-session knows there is something worth re-fetching.
let loc_fallback = false
let day_names = ["Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat"]
let day_fulls = ["Sunday" "Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday"]

// ASCII uppercase (the dialect has no case helpers); other chars pass through.
fn upcase(s){
    let lo = "abcdefghijklmnopqrstuvwxyz".split("")
    let up = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("")
    let out = ""
    for c in ("" + s).split("") {
        let u = c
        let i = 0
        while i < lo.len() {
            if c == lo[i] { u = up[i] }
            i += 1
        }
        out = out + u
    }
    return out
}

// Zeller's congruence (calendar.splash's math for an arbitrary day), 0 = Sunday.
fn weekday(y, m, d){
    let mm = m
    let yy = y
    if mm < 3 {
        mm += 12
        yy -= 1
    }
    let k = yy % 100
    let j = floor(yy / 100)
    let h = (d + floor((13.0 * (mm + 1)) / 5.0) + k + floor(k / 4.0) + floor(j / 4.0) + 5 * j) % 7
    return (h + 6) % 7
}

// WMO weather_code -> the mock vocabulary (gaps lean on the nearest bucket).
fn code_icon(c){
    if c == 0 { return "☀️" }
    if c <= 2 { return "⛅" }
    if c <= 44 { return "☁️" }
    if c <= 48 { return "🌫" }
    if c <= 70 { return "🌧" }
    if c <= 77 { return "❄️" }
    if c <= 94 { return "🌧" }
    return "⛈"
}

fn code_cond(c){
    if c == 0 { return "Sunny" }
    if c <= 2 { return "Partly Cloudy" }
    if c <= 44 { return "Cloudy" }
    if c <= 48 { return "Fog" }
    if c <= 70 { return "Rain" }
    if c <= 77 { return "Snow" }
    if c <= 94 { return "Rain" }
    return "Storm"
}

fn sync_hero(){
    let d = days[selected]
    ui.hero_icon.set_text(d.icon)
    ui.hero_icon2.set_text(d.icon)
    ui.hero_title.set_text(d.full)
    ui.hero_cond.set_text(d.cond)
    ui.hero_hl.set_text("H:" + d.hi + "°  L:" + d.lo + "°")
}

fn sync_subtitle(){
    let place = "SAN FRANCISCO"
    if host_w < 280.0 { place = "SF" }
    if city.len() > 0 { place = upcase(city) }
    ui.subtitle.set_text(place + " · TAP A DAY")
}

fn select_day(i){
    selected = i
    sync_hero()
    ui.hourly.render()
}

fn on_app_resize(w, h){
    host_w = w
    host_h = h
    ui.title_row.set_visible(h >= 520.0)
    sync_subtitle()
    ui.hero_icon_lg.set_visible(w >= 300.0)
    ui.hero_icon_sm.set_visible(w < 300.0)
    ui.chips.render()
    sync_hero()
    ui.hourly.render()
}

// A numeric element or the default: forecast rows can carry JSON nulls, and
// nil arithmetic would poison every label and bar built from them.
fn num_at(arr, i, dflt){
    if i >= arr.len() { return dflt }
    let v = arr[i]
    if v.is_nil() { return dflt }
    return v
}

// Six bar temps for day `di`: hourly carries 24 values per day and the row
// labels are 06:00..21:00, so sample indexes 6,9,12,15,18,21 of the day.
fn pick_hours(temps, di){
    let hrs = []
    let k = 0
    while k < 6 {
        let idx = di * 24 + 6 + k * 3
        let r = floor(num_at(temps, idx, 50) + 0.5)
        hrs.push(r)
        k += 1
    }
    return hrs
}

// A daily column that actually covers the five days we lay out. Server JSON
// is read by INDEX, never `dl.name`: a missing key traps on dot access, so
// the guard itself would be the thing that breaks on a surprise payload.
fn ok_col(dl, name){
    let col = dl[name]
    if !col.is_array() { return false }
    if col.len() < 5 { return false }
    return true
}

// Open-Meteo daily+hourly blocks -> five entries in the mock `days` shape.
fn build_days(dl, temps){
    let times = dl["time"]
    let codes = dl["weather_code"]
    let maxs = dl["temperature_2m_max"]
    let mins = dl["temperature_2m_min"]
    let out = []
    let di = 0
    while di < 5 {
        let parts = ("" + times[di]).split("-")
        let wd = 0
        if parts.len() == 3 { wd = weekday(parts[0].to_f64(), parts[1].to_f64(), parts[2].to_f64()) }
        let code = num_at(codes, di, 0)
        let hi = floor(num_at(maxs, di, 50) + 0.5)
        let lo = floor(num_at(mins, di, 50) + 0.5)
        let hrs = pick_hours(temps, di)
        out.push({name: day_names[wd] full: day_fulls[wd] hi: hi lo: lo cond: code_cond(code) icon: code_icon(code) hours: hrs})
        di += 1
    }
    return out
}

// Adopt a fetched forecast: rewrite `days`, cache it for the widget, and
// re-sync everything on screen. Any shape surprise bails out and leaves the
// mock (or previously cached) days in place.
fn apply_weather(v, cty){
    if !v.is_object() { return }
    let dl = v["daily"]
    if !dl.is_object() { return }
    let hr = v["hourly"]
    if !hr.is_object() { return }
    if !ok_col(dl, "time") { return }
    if !ok_col(dl, "weather_code") { return }
    if !ok_col(dl, "temperature_2m_max") { return }
    if !ok_col(dl, "temperature_2m_min") { return }
    let temps = hr["temperature_2m"]
    if !temps.is_array() { return }
    days = build_days(dl, temps)
    if cty.len() > 0 { city = cty }
    fs.write("/weather.json", {city: city days: days}.to_json())
    sync_subtitle()
    sync_hero()
    ui.chips.render()
    ui.hourly.render()
}

fn fetch_weather(wurl, lat, lon, cty){
    // Re-checked HERE, at the call, never cached from boot: the location
    // round trip is async and mod.net traps in an isolate without the grant.
    if !host.has("network") { return }
    let url = wurl + "?latitude=" + lat + "&longitude=" + lon + "&daily=weather_code,temperature_2m_max,temperature_2m_min&hourly=temperature_2m&forecast_days=5&timezone=auto"
    mod.net.http_request(mod.net.HttpRequest{url: url}, mod.net.HttpEvents{
        on_response: |res| {
            if !(res.status_code == 200) { return }
            if res.body.is_nil() { return }
            apply_weather(res.body.parse_json(), cty)
        }
        on_error: |_err| nil
    })
}

// lat/lon/city out of a location answer, or nil when there is no usable fix:
// denied, revoked mid-flight, or a payload that isn't the shape we expect.
fn loc_of(rl){
    if !rl.is_ok { return nil }
    if !rl.data.is_object() { return nil }
    // By index: `city` is optional in the service contract, and a dot read of
    // a key the payload doesn't carry traps instead of answering nil.
    let lat = rl.data["lat"]
    let lon = rl.data["lon"]
    if lat.is_nil() { return nil }
    if lon.is_nil() { return nil }
    let cty = ""
    let c = rl.data["city"]
    if !c.is_nil() { cty = "" + c }
    return {lat: lat lon: lon city: cty}
}

// Boot fetch: env endpoints, then a host location — San Francisco's
// coordinates on denial/error, which also captions the hero as SF — then
// the forecast itself. Safe to re-run: it re-checks every grant it needs.
fn start_fetch(){
    host.request("env", nil, |r| {
        if !r.is_ok { return }
        if !r.data.is_object() { return }
        let wurl_v = r.data["weather_url"]
        if wurl_v.is_nil() { return }
        // Never touch mod.net in a netless isolate — it traps.
        if !host.has("network") { return }
        let wurl = "" + wurl_v
        // Always ask rather than gating on host.has("location"): the request
        // IS the first-use prompt, and the host refuses it the instant the
        // grant is gone, so a revoked location can never be used here.
        host.request("location.get", {}, |rl| {
            let fix = loc_of(rl)
            // No fix = the SF fallback forecast, captioned SF, or a stale
            // place name would caption somebody else's coordinates.
            let lat = 37.77
            let lon = -122.42
            let cty = "San Francisco"
            loc_fallback = true
            if !fix.is_nil() {
                lat = fix.lat
                lon = fix.lon
                cty = fix.city
                loc_fallback = false
            }
            fetch_weather(wurl, lat, lon, cty)
        })
    })
}

// Membership test on the JSON array string the host hands the hook below.
fn has_cap(caps, name){
    let list = caps.parse_json()
    if !list.is_array() { return false }
    let i = 0
    while i < list.len() {
        if ("" + list[i]) == name { return true }
        i += 1
    }
    return false
}

// The host calls this on every live isolate when this app's grants move
// (except `network`, which restarts us and re-runs the boot code instead).
fn on_permissions_changed(caps){
    let has_loc = has_cap(caps, "location")
    // Revoked: forget the tracked place name. Nothing is repainted and no
    // fetch is faked — the days on screen are still the data we fetched —
    // but the next refresh captions the fallback city instead of leaving a
    // live-looking place name on a forecast we can no longer follow.
    // Also mark what's on screen as fallback-labelled: it is now captioned
    // SAN FRANCISCO, so a later re-grant must re-fetch to make the caption
    // true again rather than leaving real-location data under the wrong name.
    if !has_loc {
        city = ""
        loc_fallback = true
    }
    // Granted mid-session: re-run the fetch that fell back to SF so the
    // forecast follows the user without waiting for a restart.
    if has_loc && loc_fallback { start_fetch() }
    return nil
}

// Every cached day is dot-read all over the UI (hero, chips, bars), so the
// whole shape is checked before adoption rather than trapping mid-draw on a
// half-written file.
fn ok_day(d){
    if !d.is_object() { return false }
    let h = d["hours"]
    if !h.is_array() { return false }
    if h.len() < 6 { return false }
    if d["name"].is_nil() { return false }
    if d["full"].is_nil() { return false }
    if d["hi"].is_nil() { return false }
    if d["lo"].is_nil() { return false }
    if d["cond"].is_nil() { return false }
    if d["icon"].is_nil() { return false }
    return true
}

// A /weather.json cached by an earlier online run (ours or the widget's —
// one shared jail) keeps a real forecast on a netless boot. Reading our own
// jail needs no grant, so this is the path a revoked `network` lands on.
fn load_cache(){
    if !fs.exists("/weather.json") { return }
    let parsed = fs.read("/weather.json").parse_json()
    if !parsed.is_object() { return }
    let cached = parsed["days"]
    if !cached.is_array() { return }
    if cached.len() < 5 { return }
    let i = 0
    while i < 5 {
        if !ok_day(cached[i]) { return }
        i += 1
    }
    days = cached
    let c = parsed["city"]
    if !c.is_nil() { city = "" + c }
}

let _init = load_cache()
let _boot = start_timeout(0.05, || {
    select_day(0)
    ui.chips.render()
    sync_subtitle()
    start_fetch()
})

let Chip = glass.GlassButton{
    width: Fill
    height: Fill
    padding: Inset{left: 4, right: 4, top: 0, bottom: 0}
}

View{
    width: Fill
    height: Fit
    flow: Down
    align: Align{x: 0.5}

    col := View{
        width: Fill{max: 560.0}
        height: Fit
        flow: Down
        spacing: 12
        padding: 14

        title_row := View{
            width: Fill
            height: Fit
            flow: Down
            spacing: 2
            glass.H1{text: "Weather"}
            subtitle := glass.Caption{text: "SAN FRANCISCO · TAP A DAY"}
        }

        chips := View{
            width: Fill
            height: Fit
            flow: Down
            on_render: || {
                let ch = 58.0
                if host_h < 560.0 { ch = 44.0 }
                if host_h < 400.0 { ch = 36.0 }
                // One emission path: tiers are variables, not branches,
                // which keeps the layout math in one place (branch emission
                // itself works now — SPLASH_FINDINGS #12).
                let cols = 5
                if host_w < 250.0 { cols = 2 }
                let full = host_w >= 390.0
                // Rows are plain View literals chunked with value-only ifs
                // and count-driven whiles — single-path style kept from when
                // branch emission was broken (fixed upstream, SPLASH_FINDINGS
                // #12).
                let i = 0
                while i < 5 {
                    let n = cols
                    if i + n > 5 { n = 5 - i }
                    let pads = cols - n
                    View{width: Fill height: ch flow: Right spacing: 6.0 margin: Inset{top: 6.0}
                        let c = 0
                        while c < n {
                            let j = i + c
                            let dj = days[j]
                            let t = dj.name
                            if full { t = t + " " + dj.hi + "°" }
                            Chip{text: t on_click: || select_day(j)}
                            c += 1
                        }
                        let pc = 0
                        while pc < pads {
                            View{width: Fill height: 1}
                            pc += 1
                        }
                    }
                    i += cols
                }
            }
        }

        hero := View{
            width: Fill
            height: Fit
            glass.Card{
                width: Fill
                height: Fit
                flow: Right
                spacing: 12
                align: Align{y: 0.5}
                padding: 14
                hero_icon_lg := View{
                    width: Fit
                    height: Fit
                    hero_icon := Label{
                        text: "☀️"
                        padding: 0
                        margin: 0
                        draw_text +: {
                            color: #ffffff
                            text_style: theme.font_regular{font_size: 34}
                        }
                    }
                }
                hero_icon_sm := View{
                    visible: false
                    width: Fit
                    height: Fit
                    hero_icon2 := Label{
                        text: "☀️"
                        padding: 0
                        margin: 0
                        draw_text +: {
                            color: #ffffff
                            text_style: theme.font_regular{font_size: 22}
                        }
                    }
                }
                View{width: Fill height: Fit flow: Down spacing: 4
                    hero_title := glass.H2{text: "Monday"}
                    hero_cond := glass.Body{text: "Sunny"}
                }
                hero_hl := Label{
                    text: ""
                    padding: 0
                    margin: 0
                    draw_text +: {
                        color: #ffffff
                        text_style: theme.font_bold{font_size: 15}
                    }
                }
            }
        }

        glass.Card{
            width: Fill
            height: Fit
            flow: Down
            spacing: 8
            padding: 16
            glass.Caption{text: "HOURLY TEMPERATURE"}
            hourly := View{
                width: Fill
                height: Fit
                flow: Down
                on_render: || {
                    let d = days[selected]
                    // Bar widths re-derive from the (capped) host width so the
                    // chart fills wide panes and still fits a 190px sliver.
                    let eff = host_w
                    if eff > 560.0 { eff = 560.0 }
                    let inner = eff - 60.0
                    let lbl_w = 44.0
                    let sp = 8.0
                    let names = hour_names
                    if host_w < 300.0 { lbl_w = 26.0 sp = 6.0 names = hour_names_sm }
                    let avail = inner - lbl_w - sp - sp - 30.0
                    // Scale the bars to the day's own span: real forecasts can
                    // sit anywhere on the thermometer (°C included), so the
                    // old fixed 48..80°F window can't be assumed.
                    let mn = d.hours[0]
                    let mx = d.hours[0]
                    let s = 1
                    while s < 6 {
                        let t = d.hours[s]
                        if t < mn { mn = t }
                        if t > mx { mx = t }
                        s += 1
                    }
                    let range = mx - mn
                    if range < 1 { range = 1 }
                    let unit = (avail - 10.0) / range
                    let rh = 20.0
                    let gap = 7.0
                    if host_h < 420.0 { rh = 16.0 gap = 4.0 }
                    let i = 0
                    while i < 6 {
                        let temp = d.hours[i]
                        View{width: Fill height: rh flow: Right spacing: sp align: Align{y: 0.5} margin: Inset{top: gap}
                            glass.Caption{text: names[i] width: lbl_w}
                            RoundedView{
                                width: (10.0 + (temp - mn) * unit)
                                height: 12
                                show_bg: true
                                draw_bg +: {
                                    color: #xbcd6ffb8
                                    border_radius: 4.0
                                }
                            }
                            glass.Body{text: "" + temp + "°" width: Fit}
                        }
                        i += 1
                    }
                }
            }
        }
    }
}
